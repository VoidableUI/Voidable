#!/usr/bin/env bash
#MISE description="Validate void-* markup in docs, stories, examples, browser-test pages and adapter templates with voidable check (VOIDABLE_SKIP_GO=1 skips)"
#MISE depends=["voidable:ci"]
set -euo pipefail

if [[ "${VOIDABLE_SKIP_GO:-}" == "1" ]]; then
  echo "lint:markup skipped (VOIDABLE_SKIP_GO=1): void-* markup was NOT checked" >&2
  exit 0
fi

# Findings listed in .voidable/markup-allowlist.txt are open product decisions
# (see issue #58); anything else, or a decision's usages growing, fails.
# tests/browser/pages is in the set because stale markup there (the old
# breadcrumbs form) once slipped through unreported.
# Only tracked files are checked, so build output and framework caches
# (compiled Blade views, node_modules, _build) cannot fail the lint.
git ls-files -z -- \
  docs/src \
  packages/storybook/stories \
  tests/browser/pages \
  examples \
  packages/hotwire \
  packages/liveview/hex \
  packages/alpine/laravel \
  | xargs -0 tools/voidable/build/voidable check --allowlist .voidable/markup-allowlist.txt
echo "markup ok"
