#!/usr/bin/env bash
#MISE description="Ensure every --void-* custom property referenced in the theme, the components, the docs, the stories and the examples is defined in theme CSS or set from TypeScript"
#MISE depends=["build"]
set -euo pipefail

THEME_SRC="packages/theme/src"
UI_SRC="packages/ui/src"
# Places that only use tokens. A token misspelt here fails silently in the
# browser (the declaration is dropped), and these are the files agents and
# people copy from, so they are held to the same rule.
CONSUMERS=(docs/src packages/storybook/stories examples)

# Definitions: `--void-x:` declarations in theme CSS, component tokens, plus custom properties
# set from TypeScript (inline `style="--void-x: ..."`, setProperty('--void-x', ...) or
# a component's setHostStyle('--void-x', ...), or the overlay controller's
# _css(el, '--void-x', ...) style hook).
defined=$(
  {
    grep -rhPo --include='*.css' '(?<![\w-])--void-[a-z0-9-]+(?=\s*:)' "$THEME_SRC" || true
    # Component tokens: never declared by the theme (so one declaration of yours
    # wins), documented in an `@tokens` comment and read with a fallback.
    # lint:component-tokens keeps the comments and the reads in step.
    grep -rhPo --include='*.css' '^\s+\K--void-[a-z0-9-]+(?=\s{2,}\S)' "$THEME_SRC" || true
    grep -rhPo --include='*.ts' "(?<![\w-])--void-[a-z0-9-]+(?=\s*:)|(?:setProperty|setHostStyle)\(\s*['\"]\K--void-[a-z0-9-]+|_css\([^,()]+,\s*['\"]\K--void-[a-z0-9-]+" "$UI_SRC" || true
  } | sort -u
)

violations=0

# References: var(--void-x ...) in CSS/TS, and getPropertyValue('--void-x') in TS.
# Names ending in `-` are dynamic (e.g. --void-chart-series-${n}); the prefix must
# match at least one defined token.
while IFS=: read -r file line name; do
  [[ -z "$name" ]] && continue
  if [[ "$name" == *- ]]; then
    grep -q -- "^${name}" <<<"$defined" && continue
  else
    grep -qxF -- "$name" <<<"$defined" && continue
  fi
  echo "$file:$line: undefined token $name"
  violations=1
done < <(
  grep -rnPo --include='*.css' --include='*.ts' \
    "var\(\s*\K--void-[a-z0-9-]+|getPropertyValue\(\s*['\"]\K--void-[a-z0-9-]+" \
    "$THEME_SRC" "$UI_SRC" | sort -u
  git ls-files -z -- "${CONSUMERS[@]}" \
    | grep -zE '\.(css|ts|tsx|jsx|js|mjs|html|astro|mdx|md|vue|svelte|erb|heex|ex|php)$' \
    | xargs -0 -r grep -nPo "var\(\s*\K--void-[a-z0-9-]+" /dev/null | sort -u
)

if [[ $violations -eq 0 ]]; then
  echo "Undefined-token lint passed: every referenced --void-* token is defined"
else
  echo "ERROR: --void-* tokens referenced but never defined (define in theme CSS or set from TypeScript)"
  exit 1
fi
