#!/usr/bin/env bash
#MISE description="Ensure every referenced --void-* custom property is defined in theme CSS or set from TypeScript"
set -euo pipefail

THEME_SRC="packages/theme/src"
UI_SRC="packages/ui/src"

# Definitions: `--void-x:` declarations in theme CSS, plus custom properties
# set from TypeScript (inline `style="--void-x: ..."` or setProperty('--void-x', ...)).
defined=$(
  {
    grep -rhPo --include='*.css' '(?<![\w-])--void-[a-z0-9-]+(?=\s*:)' "$THEME_SRC" || true
    grep -rhPo --include='*.ts' "(?<![\w-])--void-[a-z0-9-]+(?=\s*:)|setProperty\(\s*['\"]\K--void-[a-z0-9-]+" "$UI_SRC" || true
  } | sort -u
)

violations=0

# References: var(--void-x ...) in CSS/TS, and getPropertyValue('--void-x') in TS.
# Names ending in `-` are dynamic (e.g. --void-chart-series-${n}); the prefix must
# match at least one defined token.
while IFS=: read -r file line name; do
  [[ -z "$name" ]] && continue
  if [[ "$name" == *- ]]; then
    grep -q -- "^${name}" <<<"$defined" && continue
  else
    grep -qxF -- "$name" <<<"$defined" && continue
  fi
  echo "$file:$line: undefined token $name"
  violations=1
done < <(
  grep -rnPo --include='*.css' --include='*.ts' \
    "var\(\s*\K--void-[a-z0-9-]+|getPropertyValue\(\s*['\"]\K--void-[a-z0-9-]+" \
    "$THEME_SRC" "$UI_SRC" | sort -u
)

if [[ $violations -eq 0 ]]; then
  echo "Undefined-token lint passed: every referenced --void-* token is defined"
else
  echo "ERROR: --void-* tokens referenced but never defined (define in theme CSS or set from TypeScript)"
  exit 1
fi
