#!/usr/bin/env bash
#MISE description="Check WCAG contrast of the derived theme tokens, in dark and light, for the default knobs, every shipped theme and skin, and the extremes of every colour knob"
set -euo pipefail

node - <<'NODE'
const fs = require('fs');
const path = require('path');
const dir = 'packages/theme/src/';
const read = (f) => fs.readFileSync(dir + f, 'utf8').replace(/\/\*[\s\S]*?\*\//g, '');
const prim = read('primitives.css');
const knobsCss = read('knobs.css');
const tok = read('tokens.css');

// ── parsing ──────────────────────────────────────────────
function decls(body) {
  const out = {};
  for (const m of body.matchAll(/(--_?void-[\w-]+)\s*:\s*([^;]+);/g)) out[m[1]] = m[2].trim().replace(/\s+/g, ' ');
  return out;
}
function block(src, headerRe) {
  const m = headerRe.exec(src);
  if (!m) throw new Error('block not found: ' + headerRe);
  let i = m.index + m[0].length, depth = 1, j = i;
  while (depth && j < src.length) { if (src[j] === '{') depth++; else if (src[j] === '}') depth--; j++; }
  return src.slice(i, j - 1);
}
const primitives = decls(block(prim, /^:root\s*\{/m));
const knobs = decls(block(knobsCss, /^:root\s*\{/m));
const derived = decls(block(tok, /^:where\(:root,[^{]*\{/m));
// UI over imagery: the fixed inputs (tokens.css) and the two surfaces
// (media/surface.css), which override derived tokens on their own element.
const mediaInputs = decls(block(tok, /^:root\s*\{\s*--void-scrim-strength/m).replace(/^/, '--void-scrim-strength'));
const surfaceCss = read('media/surface.css');
const onMedia = decls(block(surfaceCss, /^void-media,\s*\[data-void-surface="media"\]\s*\{/m));
const glass = decls(block(surfaceCss, /^void-glass,\s*\[data-void-surface="glass"\]\s*\{/m));

// The derived block is the only place a token may depend on a knob: a
// token derived on :root alone would not follow a knob set on a subtree.
let failures = 0;
const fail = (msg) => { failures++; console.log('FAIL ' + msg); };
for (const [file, src] of [['primitives.css', prim], ['knobs.css', knobsCss]]) {
  if (/var\(/.test(block(src, /^:root\s*\{/m))) fail(`${file}: :root must hold fixed values only; move anything that uses var() into the derived block of tokens.css`);
}

// User preferences must beat the knob defaults. knobs.css is imported
// after primitives.css and sets the defaults on :root, so a preference
// block in either of those files would be overridden by the default.
for (const [file, src] of [['primitives.css', prim], ['knobs.css', knobsCss]]) {
  if (/@media\s*\(prefers-(reduced-motion|contrast)/.test(src)) fail(`${file}: user-preference media queries belong in tokens.css, after the knob defaults`);
}
if (!/@media\s*\(prefers-reduced-motion:\s*reduce\)\s*\{[^}]*--void-anim-scale:\s*0\s*!important/.test(tok)) fail('tokens.css: prefers-reduced-motion must set --void-anim-scale: 0 !important');
if (!/@media\s*\(prefers-contrast:\s*more\)\s*\{[^}]*--void-contrast-boost:\s*1/.test(tok)) fail('tokens.css: prefers-contrast: more must set --void-contrast-boost: 1');

// ── tiny CSS value evaluator: var(), calc/min/max/clamp, oklch(), color-mix(in srgb) ──
function substitute(val, env, depth = 0) {
  if (depth > 60) throw new Error('var loop: ' + val);
  let out = '', i = 0;
  for (;;) {
    const at = val.indexOf('var(', i);
    if (at === -1) return out + val.slice(i);
    out += val.slice(i, at);
    let d = 1, j = at + 4;
    while (d && j < val.length) { if (val[j] === '(') d++; else if (val[j] === ')') d--; j++; }
    const inner = val.slice(at + 4, j - 1);
    const comma = inner.indexOf(',');
    const name = (comma === -1 ? inner : inner.slice(0, comma)).trim();
    // var(--x, fallback): the fallback is used when --x is not set at all
    if (name in env) out += substitute(env[name], env, depth + 1);
    else if (comma !== -1) out += substitute(inner.slice(comma + 1).trim(), env, depth + 1);
    else throw new Error('undefined ' + name);
    i = j;
  }
}
// split on a separator at parenthesis depth 0
function splitTop(s, sep) {
  const out = []; let depth = 0, cur = '';
  for (const ch of s) {
    if (ch === '(') depth++; else if (ch === ')') depth--;
    if (depth === 0 && (sep === ' ' ? /\s/.test(ch) : ch === sep)) { if (cur.trim() !== '' || sep !== ' ') out.push(cur.trim()); cur = ''; } else cur += ch;
  }
  if (cur.trim() !== '' || sep !== ' ') out.push(cur.trim());
  return out;
}
// numbers: percentages evaluate to fractions (8% → 0.08); other units are dropped
function num(expr) {
  let s = expr.trim(), pos = 0;
  const peek = () => s[pos];
  const ws = () => { while (/\s/.test(s[pos] || '')) pos++; };
  function primary() {
    ws();
    const fn = /^(calc|min|max|clamp)\(/.exec(s.slice(pos));
    if (fn) {
      pos += fn[0].length;
      const args = [sum()]; ws();
      while (peek() === ',') { pos++; args.push(sum()); ws(); }
      if (peek() !== ')') throw new Error('expected ) in ' + expr);
      pos++;
      if (fn[1] === 'calc') return args[0];
      if (fn[1] === 'min') return Math.min(...args);
      if (fn[1] === 'max') return Math.max(...args);
      return Math.max(args[0], Math.min(args[1], args[2]));
    }
    if (peek() === '(') { pos++; const v = sum(); ws(); pos++; return v; }
    const m = /^-?(\d+\.?\d*|\.\d+)(%|[a-z]+)?/.exec(s.slice(pos));
    if (!m) throw new Error(`bad number at "${s.slice(pos)}" in ${expr}`);
    pos += m[0].length;
    return m[2] === '%' ? parseFloat(m[0]) / 100 : parseFloat(m[0]);
  }
  function product() { let v = primary(); for (;;) { ws(); if (peek() === '*') { pos++; v *= primary(); } else if (peek() === '/') { pos++; v /= primary(); } else return v; } }
  function sum() { let v = product(); for (;;) { ws(); if (peek() === '+') { pos++; v += product(); } else if (peek() === '-') { pos++; v -= product(); } else return v; } }
  const v = sum(); ws();
  if (pos !== s.length) throw new Error(`trailing "${s.slice(pos)}" in ${expr}`);
  return v;
}
const toSrgb = (x) => { x = Math.min(1, Math.max(0, x)); return x <= 0.0031308 ? 12.92 * x : 1.055 * x ** (1 / 2.4) - 0.055; };
function oklch(L, C, H) {
  const a = C * Math.cos((H * Math.PI) / 180), b = C * Math.sin((H * Math.PI) / 180);
  const l = (L + 0.3963377774 * a + 0.2158037573 * b) ** 3;
  const m = (L - 0.1055613458 * a - 0.0638541728 * b) ** 3;
  const s = (L - 0.0894841775 * a - 1.291485548 * b) ** 3;
  // out-of-gamut values are clipped per channel, as browsers do on an sRGB display
  return [
    4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
    -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
    -0.0041960863 * l - 0.7034186147 * m + 1.707614701 * s,
  ].map((c) => toSrgb(c) * 255);
}
function color(val) {
  val = val.trim();
  let m;
  if ((m = /^#([0-9a-f]{6})$/i.exec(val))) return { rgb: [0, 2, 4].map((i) => parseInt(m[1].slice(i, i + 2), 16)), a: 1 };
  if (val === 'transparent') return { rgb: [0, 0, 0], a: 0 };
  if ((m = /^oklch\((.*)\)$/.exec(val))) {
    const [chan, alpha] = splitTop(m[1], '/');
    const [L, C, H] = splitTop(chan, ' ').map(num);
    return { rgb: oklch(L, C, H), a: alpha === undefined ? 1 : Math.min(1, Math.max(0, num(alpha))) };
  }
  if ((m = /^color-mix\(in srgb,(.*)\)$/.exec(val))) {
    const parts = splitTop(m[1], ',').map((part) => {
      const t = splitTop(part, ' ');
      const last = t[t.length - 1];
      const hasPct = t.length > 1 && /^(calc\(|min\(|max\(|clamp\(|-?[\d.])/.test(last);
      return { c: color(hasPct ? t.slice(0, -1).join(' ') : part), p: hasPct ? num(last) : null };
    });
    let [x, y] = parts;
    if (x.p === null && y.p === null) x.p = y.p = 0.5;
    else if (x.p === null) x.p = 1 - y.p;
    else if (y.p === null) y.p = 1 - x.p;
    const total = x.p + y.p, px = x.p / total, py = y.p / total;
    const a = x.c.a * px + y.c.a * py;
    const rgb = a === 0 ? [0, 0, 0] : x.c.rgb.map((c, i) => (c * x.c.a * px + y.c.rgb[i] * y.c.a * py) / a);
    return { rgb, a: a * Math.min(1, total) };
  }
  throw new Error('cannot resolve colour: ' + val);
}
const over = (fg, bg) => ({ rgb: fg.rgb.map((c, i) => c * fg.a + bg.rgb[i] * (1 - fg.a)), a: 1 });
const lum = ({ rgb }) => {
  const [r, g, b] = rgb.map((c) => { c /= 255; return c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4; });
  return 0.2126 * r + 0.7152 * g + 0.0722 * b;
};
function ratio(fg, bg) {
  const f = fg.a < 1 ? over(fg, bg) : fg;
  const [hi, lo] = [lum(f), lum(bg)].sort((a, b) => b - a);
  return (hi + 0.05) / (lo + 0.05);
}

// ── the pairs ────────────────────────────────────────────
const verbose = process.env.CONTRAST_VERBOSE === '1';
const statuses = ['error', 'warning', 'caution', 'success', 'info', 'notice', 'highlight'];
// every surface text can sit on; the page first
const surfaces = ['bg', 'surface', 'bg-secondary', 'bg-elevated', 'bg-hover'];
const roles = ['label', 'value', 'unit', 'caption', 'heading', 'title', 'display', 'lede', 'body', 'code'];

function checkConfig(name, overrides, { quiet = false, skin = {} } = {}) {
  let local = 0;
  for (const [mode, dark] of [['dark', 1], ['light', 0]]) {
    const env = { ...primitives, ...knobs, ...mediaInputs, '--void-scheme-system': '1', '--void-scheme-explicit': String(dark), '--void-contrast-boost': '0', '--void-shape': '1', ...overrides, ...derived, ...skin };
    const raw = (token) => substitute(`var(${token})`, env);
    const page = color(raw('--void-color-bg'));
    // surfaces are opaque; anything translucent is composited over the page
    const c = (n) => { const v = color(raw(`--void-color-${n}`)); return v; };
    const solid = (n) => { const v = c(n); return v.a < 1 ? over(v, page) : v; };
    const check = (label, fg, bg, min) => {
      const r = ratio(fg, bg);
      const ok = r >= min;
      if (!ok) { failures++; local++; }
      if ((!ok && !quiet) || verbose) console.log(`${ok ? 'ok  ' : 'FAIL'} [${name}, ${mode}] ${label}: ${r.toFixed(2)} (min ${min})`);
    };
    const tint = num(raw('--void-tone-tint'));
    const tintOf = (toneName, base, k = 1) => over({ rgb: c(toneName).rgb, a: Math.min(1, tint * k) }, base);

    for (const s of surfaces) {
      const bg = solid(s);
      for (const t of ['text', 'text-secondary', 'text-muted', 'text-tertiary']) check(`${t} on ${s}`, c(t), bg, 4.5);
      // type roles carry their own colour token
      for (const r of roles) check(`type role ${r} on ${s}`, color(raw(`--void-type-${r}-color`)), bg, 4.5);
      // the accent is also used as text (links, selected items)
      check(`accent as text on ${s}`, c('accent'), bg, 4.5);
      // non-text boundaries and indicators
      check(`border-control on ${s}`, c('border-control'), bg, 3);
      check(`border-focus on ${s}`, c('border-focus'), bg, 3);
      check(`focus-ring-color on ${s}`, color(raw('--void-focus-ring-color')), bg, 3);
      // ghost button (default tone): the label on its hover and pressed fills
      check(`ghost button label on its hover fill over ${s}`, c('text'), over({ rgb: c('accent').rgb, a: 0.08 }, bg), 4.5);
      check(`ghost button label on its pressed fill over ${s}`, c('text'), over({ rgb: c('accent').rgb, a: 0.13 }, bg), 4.5);
      // status colours as text, and a coloured ghost button on every surface:
      // at rest, on its hover fill (the tone tint) and on its pressed fill
      for (const st of statuses) {
        check(`${st} text on ${s}`, c(st), bg, 4.5);
        check(`ghost ${st} button label on its hover fill over ${s}`, c(st), tintOf(st, bg), 4.5);
        check(`ghost ${st} button label on its pressed fill over ${s}`, c(st), tintOf(st, bg, 1.25), 4.5);
      }
    }
    // Roles and component tokens. A role surface is a semantic surface until a
    // skin assigns it; then it is a new place text sits, and it is held to the
    // same minimums. Every `…-surface` token in force is checked: with the
    // `…-ink` of the same name when that is assigned (a tooltip, the current
    // navigation link), otherwise with every text colour that can land on it.
    const tokenColor = (token) => color(raw(token));
    const flat = (v) => (v.a < 1 ? over(v, page) : v);
    const surfaceTokens = new Set(['--void-container-surface', '--void-float-surface', '--void-field-surface', '--void-item-surface-selected', ...Object.keys(skin).filter((k) => /^--void-[a-z0-9-]+-surface(-[a-z]+)?$/.test(k))]);
    for (const token of surfaceTokens) {
      let bg;
      try { bg = flat(tokenColor(token)); } catch { fail(`[${name}, ${mode}] ${token} is not a colour lint:contrast can evaluate`); continue; }
      const short = token.slice(7);
      const ink = token.replace(/-surface(-[a-z]+)?$/, '-ink$1');
      if (ink in skin || ink in derived) { check(`${ink.slice(7)} on ${short}`, tokenColor(ink), bg, 4.5); continue; }
      for (const t of ['text', 'text-secondary', 'text-muted']) check(`${t} on ${short}`, c(t), bg, 4.5);
      for (const r of roles) check(`type role ${r} on ${short}`, color(raw(`--void-type-${r}-color`)), bg, 4.5);
      check(`accent as text on ${short}`, c('accent'), bg, 4.5);
      for (const st of statuses) check(`${st} text on ${short}`, c(st), bg, 4.5);
      check(`border-control on ${short}`, c('border-control'), bg, 3);
      check(`focus-ring-color on ${short}`, color(raw('--void-focus-ring-color')), bg, 3);
    }
    // An ink with no surface of its own sits on the page.
    for (const token of Object.keys(skin).filter((k) => /^--void-[a-z0-9-]+-ink(-[a-z]+)?$/.test(k))) {
      if (!(token.replace(/-ink(-[a-z]+)?$/, '-surface$1') in skin)) check(`${token.slice(7)} on bg`, tokenColor(token), page, 4.5);
    }
    // The edge of a field is its only boundary: 3:1 against its fill and the page.
    check('control-border on bg', tokenColor('--void-control-border'), page, 3);
    check('field-border on field-surface', tokenColor('--void-field-border'), flat(tokenColor('--void-field-surface')), 3);
    check('field-border on bg', tokenColor('--void-field-border'), page, 3);

    check('text on bg-active (pressed, selected segment)', c('text'), solid('bg-active'), 4.5);
    check('text-on-accent on accent fill', c('text-on-accent'), c('accent'), 4.5);
    check('text-on-accent on accent-hover fill', c('text-on-accent'), solid('accent-hover'), 4.5);
    for (const st of statuses) {
      check(`text-on-accent on ${st} fill`, c('text-on-accent'), c(st), 4.5);
      check(`${st} text on own subtle tint over bg`, c(st), over(c(`${st}-subtle`), page), 4.5);
    }
    // Tone tints (outline badge, alert, stat, tag): --void-tone-tint of the tone over a surface.
    for (const st of ['accent', ...statuses]) for (const s of ['bg', 'surface', 'bg-secondary']) {
      const base = solid(s);
      check(`outline badge text (${st}) on its tint over ${s}`, c(st), tintOf(st, base), 4.5);
      check(`text on ${st} tint over ${s}`, c('text'), tintOf(st, base), 4.5);
      check(`stat label (text-secondary) on ${st} tint over ${s}`, c('text-secondary'), tintOf(st, base), 4.5);
    }
  }
  return local;
}

// ── UI over imagery ──────────────────────────────────────
// Text on a media surface sits on the scrim, and the scrim sits on a
// photograph nobody has seen. The guarantee is therefore made against
// the worst backdrops there are: a pure white image, a pure black one
// and mid grey. A glass panel is in the page's scheme, so it is checked
// in both schemes, translucent and solid (reduced transparency).
const backdrops = { white: { rgb: [255, 255, 255], a: 1 }, grey: { rgb: [128, 128, 128], a: 1 }, black: { rgb: [0, 0, 0], a: 1 } };
function checkSurfaces(name, overrides, { quiet = false } = {}) {
  let local = 0;
  const check = (label, fg, bg, min) => {
    const r = ratio(fg, bg);
    const ok = r >= min;
    if (!ok) { failures++; local++; }
    if ((!ok && !quiet) || verbose) console.log(`${ok ? 'ok  ' : 'FAIL'} [${name}] ${label}: ${r.toFixed(2)} (min ${min})`);
  };
  const textChecks = (where, env, base) => {
    const raw = (token) => substitute(`var(${token})`, env);
    const c = (n) => color(raw(`--void-color-${n}`));
    const tint = num(raw('--void-tone-tint'));
    for (const t of ['text', 'text-secondary', 'text-muted', 'text-tertiary']) check(`${t} ${where}`, c(t), base, 4.5);
    for (const r of roles) check(`type role ${r} ${where}`, color(raw(`--void-type-${r}-color`)), base, 4.5);
    check(`border-control ${where}`, c('border-control'), base, 3);
    check(`focus ring ${where}`, color(raw('--void-focus-ring-color')), base, 3);
    check(`ghost button label on its hover fill ${where}`, c('text'), over({ rgb: c('accent').rgb, a: 0.08 }, base), 4.5);
    return { c, tint, raw };
  };
  for (const [mode, dark] of [['dark', 1], ['light', 0]]) {
    const baseEnv = { ...primitives, ...knobs, ...mediaInputs, '--void-scheme-system': '1', '--void-scheme-explicit': String(dark), '--void-contrast-boost': '0', '--void-shape': '1', ...overrides, ...derived };
    for (const [bname, backdrop] of Object.entries(backdrops)) {
      // on-media: the same in both page schemes, checked in both anyway
      {
        const env = { ...baseEnv, ...onMedia };
        const raw = (token) => substitute(`var(${token})`, env);
        const scrim = over(color(raw('--void-color-bg')), backdrop);
        const where = `on the scrim over a ${bname} image (${mode} page)`;
        const { c, tint } = textChecks(where, env, scrim);
        // a field: its fill is the surface colour, on the scrim
        const field = over(color(raw('--void-color-surface')), scrim);
        check(`field text ${where}`, c('text'), field, 4.5);
        check(`field placeholder ${where}`, c('text-muted'), field, 4.5);
        // controls that draw no fill of their own may sit where the scrim
        // has faded: their shade alone has to carry them
        const fill = over(c('control-fill'), backdrop);
        check(`outline button label on its fill over a bare ${bname} image (${mode} page)`, c('text'), fill, 4.5);
        check(`outline button border on its fill over a bare ${bname} image (${mode} page)`, c('border-control'), fill, 3);
        for (const st of ['accent', ...statuses]) {
          check(`outline badge (${st}) on its fill over a bare ${bname} image (${mode} page)`, c(st), over({ rgb: c(st).rgb, a: tint }, fill), 4.5);
        }
        check(`filled button label on media (${mode} page)`, c('text-on-accent'), c('accent'), 4.5);
      }
      // glass, translucent and solid
      for (const solidGlass of ['0', '1']) {
        const env = { ...baseEnv, '--void-glass-solid': solidGlass, ...glass };
        const raw = (token) => substitute(`var(${token})`, env);
        const panel = over(color(raw('--void-color-bg')), backdrop);
        const where = `on ${solidGlass === '1' ? 'solid ' : ''}glass over a ${bname} image (${mode})`;
        const { c, tint } = textChecks(where, env, panel);
        for (const st of statuses) {
          check(`${st} text ${where}`, c(st), panel, 4.5);
          check(`outline badge (${st}) ${where}`, c(st), over({ rgb: c(st).rgb, a: tint }, panel), 4.5);
        }
        check(`accent as text ${where}`, c('accent'), panel, 4.5);
        check(`field text ${where}`, c('text'), over(color(raw('--void-color-surface')), panel), 4.5);
        check(`field placeholder ${where}`, c('text-muted'), over(color(raw('--void-color-surface')), panel), 4.5);
      }
    }
  }
  return local;
}

// 1. the default knobs, and the default with the user's contrast preference
checkConfig('default', {});
checkConfig('default + prefers-contrast', { '--void-contrast-boost': '1' });
checkSurfaces('default', {});
checkSurfaces('default + prefers-contrast', { '--void-contrast-boost': '1' });

// 2. every shipped theme: a theme whose knobs produce failing contrast fails CI
const themesDir = dir + 'themes/';
const themes = fs.existsSync(themesDir) ? fs.readdirSync(themesDir).filter((f) => f.endsWith('.css')) : [];
for (const file of themes) {
  const src = fs.readFileSync(themesDir + file, 'utf8').replace(/\/\*[\s\S]*?\*\//g, '');
  const set = decls(src);
  for (const k of Object.keys(set)) if (!(k in knobs) && !/^--void-preferred-scheme(-dark)?$/.test(k)) fail(`themes/${file}: ${k} is not a knob; a theme may only set the knobs declared in knobs.css`);
  if (/[^-\w](?!--void-)[a-z-]+\s*:\s*[^;{}]+;/.test(src.replace(/--void-[\w-]+\s*:\s*[^;]+;/g, ''))) fail(`themes/${file}: a theme may only contain knob declarations`);
  checkConfig(`theme ${path.basename(file, '.css')}`, set);
  checkSurfaces(`theme ${path.basename(file, '.css')}`, set);
}

// 2b. every shipped skin. A skin is one rule of token assignments (derived,
//     role and component tokens), so it can break what the knobs guarantee:
//     it is checked on the default knobs, on every theme and across the
//     colour knobs, including every `…-surface` and `…-ink` it assigns. Its
//     colours do not reach the media and glass surfaces (build/skins.js
//     leaves them out there), which derive their own.
const skinsDir = dir + 'skins/';
const skins = fs.existsSync(skinsDir) ? fs.readdirSync(skinsDir).filter((f) => f.endsWith('.css')) : [];
let skinSweeps = 0;
for (const file of skins) {
  const src = fs.readFileSync(skinsDir + file, 'utf8').replace(/\/\*[\s\S]*?\*\//g, '');
  const first = /^\[data-void-skin="[a-z0-9-]+"\]\s*\{([^{}]*)\}$/.exec(src.trim());
  const name = path.basename(file, '.css');
  if (!first) { fail(`skins/${file}: a skin is one rule, [data-void-skin="${name}"] { … }, of token assignments (lint:component-tokens says what is wrong)`); continue; }
  const skin = decls(first[1]);
  for (const k of Object.keys(skin)) if (k in knobs) fail(`skins/${file}: ${k} is a knob; a skin overrides derived tokens and leaves the knobs to the theme`);
  checkConfig(`skin ${name}`, {}, { skin });
  checkConfig(`skin ${name} + prefers-contrast`, { '--void-contrast-boost': '1' }, { skin });
  for (const t of themes) checkConfig(`skin ${name} on theme ${path.basename(t, '.css')}`, decls(fs.readFileSync(themesDir + t, 'utf8').replace(/\/\*[\s\S]*?\*\//g, '')), { skin });
  const skinSweep = (label, overrides) => { skinSweeps++; const n = checkConfig(label, overrides, { quiet: !verbose, skin }); if (n) { console.log(`FAIL skin sweep [${label}]: ${n} pair(s) below the minimum (CONTRAST_VERBOSE=1 lists them)`); } };
  for (const contrast of ['0', '1']) for (const chrome of ['0', '1']) skinSweep(`skin ${name}, contrast ${contrast}, chrome ${chrome}`, { '--void-contrast': contrast, '--void-chrome': chrome });
  for (const chroma of ['0.1', '0.2', '0.3']) for (let hue = 0; hue < 360; hue += 30) skinSweep(`skin ${name}, accent chroma ${chroma}, hue ${hue}`, { '--void-accent-chroma': chroma, '--void-accent-hue': String(hue), '--void-contrast': '0' });
  for (const chroma of ['0', '0.04']) for (let hue = 0; hue < 360; hue += 30) skinSweep(`skin ${name}, neutral chroma ${chroma}, hue ${hue}`, { '--void-neutral-chroma': chroma, '--void-neutral-hue': String(hue), '--void-contrast': '0', '--void-chrome': '1' });
}

// 3. the guarantee: no setting of a colour knob can take text below AA.
//    Sweep each knob to its extremes (values outside the range are clamped
//    by the derivation, so the far-out values are part of the sweep).
let sweeps = 0, sweepFailures = 0;
const sweep = (label, overrides) => { sweeps++; const n = checkConfig(label, overrides, { quiet: !verbose }); if (n) { sweepFailures++; console.log(`FAIL knob sweep [${label}]: ${n} pair(s) below the minimum (CONTRAST_VERBOSE=1 lists them)`); } };
for (const contrast of ['-1', '0', '0.5', '1', '5']) for (const chrome of ['-1', '0', '0.5', '1', '5']) {
  sweep(`contrast ${contrast}, chrome ${chrome}`, { '--void-contrast': contrast, '--void-chrome': chrome });
}
for (const chroma of ['0.05', '0.1', '0.15', '0.2', '0.3', '0.5']) for (let hue = 0; hue < 360; hue += 15) {
  sweep(`accent chroma ${chroma}, hue ${hue}`, { '--void-accent-chroma': chroma, '--void-accent-hue': String(hue), '--void-contrast': '0' });
}
for (const chroma of ['0.01', '0.02', '0.04', '0.2']) for (let hue = 0; hue < 360; hue += 30) for (const page of ['0', '0.5', '1', '3']) {
  sweep(`neutral chroma ${chroma}, hue ${hue}, page tint ${page}`, { '--void-neutral-chroma': chroma, '--void-neutral-hue': String(hue), '--void-page-tint': page, '--void-contrast': '0', '--void-chrome': '1' });
}
for (const page of ['0.5', '1']) for (let hue = 0; hue < 360; hue += 30) {
  sweep(`page tint ${page}, accent hue ${hue}`, { '--void-neutral-chroma': '0.04', '--void-neutral-hue': String((hue + 180) % 360), '--void-page-tint': page, '--void-accent-chroma': '0.2', '--void-accent-hue': String(hue), '--void-contrast': '0' });
}

// the most saturated accents on a tinted page, on every hue
for (const chroma of ['0.25', '0.3']) for (const page of ['0.5', '1']) for (let hue = 0; hue < 360; hue += 15) for (const chrome of ['0.3', '1']) {
  sweep(`page tint ${page}, accent chroma ${chroma}, hue ${hue}, chrome ${chrome}`, { '--void-page-tint': page, '--void-accent-chroma': chroma, '--void-accent-hue': String(hue), '--void-chrome': chrome, '--void-contrast': '0' });
}

// 4. the scrim: no strength may take text on a media surface below AA,
//    and the knobs that move text and surfaces are swept there as well.
const surfaceSweep = (label, overrides) => { sweeps++; const n = checkSurfaces(label, overrides, { quiet: !verbose }); if (n) { sweepFailures++; console.log(`FAIL surface sweep [${label}]: ${n} pair(s) below the minimum (CONTRAST_VERBOSE=1 lists them)`); } };
for (const strength of ['-1', '0', '0.5', '1', '5']) surfaceSweep(`scrim strength ${strength}`, { '--void-scrim-strength': strength });
for (const contrast of ['-1', '0', '1', '5']) for (const chrome of ['-1', '0', '1', '5']) surfaceSweep(`surfaces, contrast ${contrast}, chrome ${chrome}`, { '--void-contrast': contrast, '--void-chrome': chrome });
for (const chroma of ['0.1', '0.2', '0.3']) for (let hue = 0; hue < 360; hue += 30) surfaceSweep(`surfaces, accent chroma ${chroma}, hue ${hue}`, { '--void-accent-chroma': chroma, '--void-accent-hue': String(hue), '--void-contrast': '0' });
for (const page of ['0.5', '1']) for (let hue = 0; hue < 360; hue += 60) surfaceSweep(`surfaces, page tint ${page}, neutral hue ${hue}`, { '--void-neutral-chroma': '0.04', '--void-neutral-hue': String(hue), '--void-page-tint': page, '--void-contrast': '0', '--void-chrome': '1' });

// The surfaces must stay what the checks above assume they are.
if (!/--void-scheme-dark:\s*1;/.test(block(surfaceCss, /^void-media,\s*\[data-void-surface="media"\]\s*\{/m))) fail('media/surface.css: the on-media surface must set --void-scheme-dark: 1');
if (!/--void-scheme-dark:\s*var\(--void-page-scheme-dark\);/.test(block(surfaceCss, /^void-glass,\s*\[data-void-surface="glass"\]\s*\{/m))) fail('media/surface.css: glass must return to the page scheme (--void-scheme-dark: var(--void-page-scheme-dark))');
const mediaCss = read('media/media.css');
if (!/var\(--void-color-scrim\) var\(--void-scrim-fade\)/.test(mediaCss)) fail('media/media.css: the scrim gradient must reach var(--void-color-scrim) at var(--void-scrim-fade), where the content region begins');
if (!/@media \(prefers-reduced-transparency: reduce\)\s*\{\s*:root\s*\{\s*--void-glass-solid:\s*1/.test(tok)) fail('tokens.css: prefers-reduced-transparency must set --void-glass-solid: 1');
if (!/@supports not \(\(backdrop-filter[^{]*\{\s*:root\s*\{\s*--void-glass-solid:\s*1/.test(tok)) fail('tokens.css: browsers without backdrop-filter must get --void-glass-solid: 1');

// ── the default button's border is the control boundary token ──
// The button reflects color="default", so a bare void-button[color] selector
// would also turn the default border into a tone mix (below 3:1 in light).
const buttonCss = fs.readFileSync(dir + 'components/button.css', 'utf8');
if (/void-button\[color\]\s*\{[^}]*--_void-tone-border/.test(buttonCss)) {
  fail('button.css: void-button[color] must exclude color="default" when overriding --_void-tone-border');
}
// The ghost fills checked above are the ones button.css declares.
for (const [what, re] of [
  ['default hover fill of 8%', /--_void-tone-hover:\s*color-mix\(in srgb, var\(--_void-tone\) 8%, transparent\)/],
  ['default pressed fill of 13%', /--_void-tone-active:\s*color-mix\(in srgb, var\(--_void-tone\) 13%, transparent\)/],
  ['coloured ghost hover fill of --void-tone-tint', /void-button\[variant="ghost"\]\[color\]:not\(\[color="default"\]\)\s*\{[^}]*--_void-tone-hover:\s*color-mix\(in srgb, var\(--_void-tone\) var\(--void-tone-tint\), transparent\)/],
  ['coloured ghost pressed fill of 1.25 × --void-tone-tint', /void-button\[variant="ghost"\]\[color\]:not\(\[color="default"\]\)\s*\{[^}]*--_void-tone-active:\s*color-mix\(in srgb, var\(--_void-tone\) calc\(var\(--void-tone-tint\) \* 1\.25\), transparent\)/],
]) {
  if (!re.test(buttonCss)) fail(`button.css: expected the ${what}; update lint:contrast together with the button's fills`);
}

if (failures) { console.log(`Contrast check failed: ${failures} problem(s)`); process.exit(1); }
console.log(`Contrast check passed: default, ${themes.length} theme(s), ${skins.length} skin(s) and ${sweeps + skinSweeps} knob settings, dark and light`);
NODE
