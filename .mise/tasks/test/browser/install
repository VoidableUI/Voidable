#!/usr/bin/env bash
#MISE description="Download the browsers the real-browser suite runs on (pass --with-deps on Debian/Ubuntu to add system libraries)"
#MISE depends=["install"]
set -euo pipefail

# VOID_BROWSERS picks the engines, as it does for test:browser
# (default chromium,firefox,webkit). Extra arguments go to `playwright install`.
IFS=, read -r -a browsers <<< "${VOID_BROWSERS:-chromium,firefox,webkit}"
cd tests/browser
exec ./node_modules/.bin/playwright install "$@" "${browsers[@]}"
