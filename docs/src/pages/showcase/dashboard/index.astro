---
import DashboardLayout from '../../../components/showcase/DashboardLayout.astro';
import iconChevronDown from '@tabler/icons/outline/chevron-down.svg?raw';
import iconBell from '@tabler/icons/outline/bell.svg?raw';
import iconFilter from '@tabler/icons/outline/filter.svg?raw';
import { openAlerts, series, totals, week } from '../../../data/showcase-network';

const throughput = {
  labels: week,
  series: [
    { name: 'Downlink', values: [4.1, 4.6, 4.4, 5.2, 5.0, 4.7, 4.8] },
    { name: 'Uplink', values: [1.1, 1.3, 1.2, 1.5, 1.4, 1.2, 1.3] },
  ],
};
const status = {
  segments: [
    { name: 'Online', value: totals.online, color: 'var(--void-color-success)' },
    { name: 'Degraded', value: totals.degraded, color: 'var(--void-color-warning)' },
    { name: 'Maintenance', value: totals.maintenance, color: 'var(--void-color-info)' },
    { name: 'Offline', value: totals.offline, color: 'var(--void-color-error)' },
  ],
};
const latency = {
  labels: week,
  series: [
    { name: 'P99', values: series(7, 96, 22, 5) },
    { name: 'P50', values: series(7, 38, 4, 7) },
  ],
};
const distance = {
  labels: ['SVB1', 'SVB2', 'TOS1', 'TOS2', 'PUQ1', 'SIN1', 'MRU1', 'HBK1'],
  series: [{ name: 'Mean slant range', values: [1128, 1764, 912, 2240, 1385, 1942, 1610, 1206] }],
};

const passes = [
  { dot: 'online', state: 'Tracking', band: 'Ka', satellite: 'MRD-0412', station: 'Svalbard 1', latency: '31 ms', throughput: '842 Mbit/s', distance: '1,128 km', time: 'now' },
  { dot: 'online', state: 'Tracking', band: 'X', satellite: 'MRD-0431', station: 'Tromsø 1', latency: '36 ms', throughput: '574 Mbit/s', distance: '912 km', time: 'now' },
  { dot: 'away', state: 'Degraded', band: 'S', satellite: 'MRD-0377', station: 'Tromsø 2', latency: '118 ms', throughput: '96 Mbit/s', distance: '2,240 km', time: '2 min ago' },
  { dot: 'online', state: 'Complete', band: 'Ka', satellite: 'MRD-0420', station: 'Punta Arenas', latency: '44 ms', throughput: '266 Mbit/s', distance: '1,385 km', time: '4 min ago' },
  { dot: 'offline', state: 'Missed', band: 'X', satellite: 'MRD-0391', station: 'Troll', latency: '—', throughput: '—', distance: '—', time: '11 min ago' },
  { dot: 'online', state: 'Complete', band: 'X', satellite: 'MRD-0398', station: 'Svalbard 2', latency: '33 ms', throughput: '203 Mbit/s', distance: '1,764 km', time: '14 min ago' },
  { dot: 'away', state: 'Degraded', band: 'S', satellite: 'MRD-0368', station: 'Singapore', latency: '87 ms', throughput: '148 Mbit/s', distance: '2,318 km', time: '18 min ago' },
  { dot: 'online', state: 'Complete', band: 'X', satellite: 'MRD-0412', station: 'Hartebeesthoek', latency: '49 ms', throughput: '311 Mbit/s', distance: '1,206 km', time: '26 min ago' },
];
---

<DashboardLayout
  active="overview"
  heading="Overview"
  title="Dashboard Showcase — Voidable"
  description="A realistic operations dashboard for a satellite ground network, built with Voidable components."
>
  <Fragment slot="controls">
    <void-segmented-control value="1w" aria-label="Period">
      <void-segmented-control-item value="1d">1D</void-segmented-control-item>
      <void-segmented-control-item value="1w">1W</void-segmented-control-item>
      <void-segmented-control-item value="1m">1M</void-segmented-control-item>
      <void-segmented-control-item value="3m">3M</void-segmented-control-item>
    </void-segmented-control>

    <void-indicator color="error" count={openAlerts} ping placement="top-right">
      <void-button variant="outline" size="md">
        <span class="icon-inline" set:html={iconBell} />
        Notifications
      </void-button>
    </void-indicator>

    <void-dropdown-menu align="end">
      <void-dropdown-menu-trigger><void-button variant="outline" size="md">
        Actions
        <span class="icon-inline icon-chevron" set:html={iconChevronDown} />
      </void-button></void-dropdown-menu-trigger>
      <void-dropdown-menu-content>
        <void-dropdown-menu-item>Export CSV</void-dropdown-menu-item>
        <void-dropdown-menu-item>Share Link</void-dropdown-menu-item>
        <void-dropdown-menu-item>Refresh Data</void-dropdown-menu-item>
        <void-dropdown-menu-item destructive>Delete Report</void-dropdown-menu-item>
      </void-dropdown-menu-content>
    </void-dropdown-menu>
  </Fragment>

  <!-- Stats row -->
  <div class="stats-row">
    <void-stat label="Nodes online" value={`${totals.online}/${totals.nodes}`} delta={`${totals.offline} offline`} trend="error"></void-stat>
    <void-stat label="Latency" value="38ms" delta="-4ms" trend="up"></void-stat>
    <void-stat label="Throughput" value="4.8Gb/s" delta="+6.1%" trend="up"></void-stat>
    <void-stat label="Distance" value="1,480km" delta="+32km" trend="flat"></void-stat>
  </div>

  <!-- Main content -->
  <div class="content-area">

    <!-- Toolbar row -->
    <div class="toolbar-row">
      <span class="toolbar-label">View</span>
      <void-toggle variant="outline" size="sm" pressed>Live</void-toggle>
      <void-toggle variant="outline" size="sm">Alerts</void-toggle>
      <void-toggle variant="outline" size="sm">Compare</void-toggle>
      <void-divider orientation="vertical"></void-divider>
      <span class="toolbar-label">Layer</span>
      <void-toggle variant="outline" size="sm" pressed>P99</void-toggle>
      <void-toggle variant="outline" size="sm">P50</void-toggle>
      <div class="toolbar-spacer"></div>
      <void-popover side="bottom">
        <void-popover-trigger><void-button variant="outline" size="md">
          <span class="icon-inline" set:html={iconFilter} />
          Filter
        </void-button></void-popover-trigger>
        <void-popover-content>
          <div class="filter-popover">
            <div class="filter-section">
              <span class="filter-label">Node State</span>
              <void-checkbox-group aria-label="Node states">
                <void-checkbox value="online" checked>Online</void-checkbox>
                <void-checkbox value="degraded" checked>Degraded</void-checkbox>
                <void-checkbox value="maintenance" checked>Maintenance</void-checkbox>
                <void-checkbox value="offline" checked>Offline</void-checkbox>
              </void-checkbox-group>
            </div>
            <div class="filter-section">
              <span class="filter-label">Band</span>
              <void-checkbox-group aria-label="Bands">
                <void-checkbox value="S" checked>S-band</void-checkbox>
                <void-checkbox value="X" checked>X-band</void-checkbox>
                <void-checkbox value="Ka">Ka-band</void-checkbox>
              </void-checkbox-group>
            </div>
            <div class="filter-section">
              <span class="filter-label">Latency</span>
              <void-select aria-label="Latency" size="sm">
                <select>
                  <option value="all">All</option>
                  <option value="fast">&lt; 50ms</option>
                  <option value="moderate">50–100ms</option>
                  <option value="slow">&gt; 100ms</option>
                </select>
              </void-select>
            </div>
            <div class="filter-actions">
              <void-button variant="ghost" size="sm">Reset</void-button>
              <void-button variant="filled" size="sm">Apply</void-button>
            </div>
          </div>
        </void-popover-content>
      </void-popover>
    </div>

    <!-- Charts -->
    <div class="charts-grid">
      <div class="chart-panel">
        <div class="chart-panel-header">
          <span class="chart-panel-title">Throughput</span>
          <span class="chart-panel-meta">Gbit/s · last 7 days</span>
        </div>
        <void-line-chart height="240" aria-label="Downlink and uplink throughput in gigabits per second over the last seven days" data={JSON.stringify(throughput)}></void-line-chart>
      </div>

      <div class="chart-panel">
        <div class="chart-panel-header">
          <span class="chart-panel-title">Node Status</span>
          <span class="chart-panel-meta">online and offline</span>
        </div>
        <void-donut-chart size="200" variant="outline" show-total aria-label="Nodes by state" data={JSON.stringify(status)}></void-donut-chart>
      </div>
    </div>

    <!-- Second charts row -->
    <div class="charts-grid charts-grid-half">
      <div class="chart-panel">
        <div class="chart-panel-header">
          <span class="chart-panel-title">Latency</span>
          <span class="chart-panel-meta">ms · round trip</span>
        </div>
        <void-line-chart height="200" aria-label="Round-trip latency in milliseconds, P99 and P50" data={JSON.stringify(latency)}></void-line-chart>
      </div>

      <div class="chart-panel">
        <div class="chart-panel-header">
          <span class="chart-panel-title">Link Distance</span>
          <span class="chart-panel-meta">km · by station</span>
        </div>
        <void-bar-chart height="200" variant="outline" aria-label="Mean slant range in kilometres by ground station" data={JSON.stringify(distance)}></void-bar-chart>
      </div>
    </div>

    <!-- Recent passes table -->
    <div class="table-section">
      <div class="table-section-header">
        <span class="table-section-title">Recent Passes</span>
        <div style="display:flex; align-items:center; gap:var(--void-space-4);">
          <span class="table-section-count">1,284 today</span>
          <void-button variant="ghost" size="sm"><a href="/showcase/dashboard/analytics/">View all</a></void-button>
        </div>
      </div>

      <void-table aria-label="Recent passes">
        <table>
          <thead>
            <tr>
              <th>Status</th>
              <th>Band</th>
              <th>Satellite</th>
              <th>Station</th>
              <th>Latency</th>
              <th>Throughput</th>
              <th>Distance</th>
              <th>Time</th>
            </tr>
          </thead>
          <tbody>
            {passes.map((p) => (
              <tr>
                <td><span class="cell-with-dot"><void-status-dot status={p.dot}></void-status-dot>{p.state}</span></td>
                <td><void-tag size="sm">{p.band}</void-tag></td>
                <td class="mono">{p.satellite}</td>
                <td class="text-sm">{p.station}</td>
                <td class="mono">{p.latency}</td>
                <td class="mono">{p.throughput}</td>
                <td class="mono">{p.distance}</td>
                <td class="text-sm text-secondary">{p.time}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </void-table>
    </div>

  </div>
</DashboardLayout>
