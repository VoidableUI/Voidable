---
// The theme builder. Turn the knobs, watch a real application change, leave
// with a theme: the dozen-line CSS, a link that carries every knob, a
// description for an agent, and the tokens as DTCG JSON.
//
// The preview is ./preview.astro in an iframe (see there for why). The
// controls are generated from the knob data in @voidable/theme
// (build/knobs.js); the presets are the theme files of the package, read
// here, so this page cannot drift from what is published. The page itself
// is built from Voidable components and patterns, in the default theme:
// the chrome does not move while you turn a knob.
import '@voidable/theme';
import '../../../../packages/theme/dist/skins/loft.css';
import '../../../../packages/theme/dist/skins/slab.css';
import knobsCss from '../../../../packages/theme/src/knobs.css?raw';
import iconBrandGithub from '@tabler/icons/outline/brand-github.svg?raw';
import iconSun from '@tabler/icons/outline/sun.svg?raw';
import iconMoon from '@tabler/icons/outline/moon.svg?raw';
import iconDice from '@tabler/icons/outline/dice-5.svg?raw';
import iconCopy from '@tabler/icons/outline/copy.svg?raw';
import iconDownload from '@tabler/icons/outline/download.svg?raw';
import iconLink from '@tabler/icons/outline/link.svg?raw';
import iconReset from '@tabler/icons/outline/arrow-back-up.svg?raw';
import { declarations, ruleBody, stripComments } from '../../../../packages/theme/build/css-eval.js';
import { fontStacks, knobs, skins } from '../../../../packages/theme/build/knobs.js';
import { DTCG_VERSION, readTheme } from '../../../../packages/theme/build/tokens.js';

// Every theme file of the package is a preset; its stylesheet is loaded so a
// preset's swatch can draw itself with data-void-theme.
import.meta.glob(['../../../../packages/theme/dist/themes/*.css', '!../../../../packages/theme/dist/themes/*.min.css'], { eager: true });
const themeFiles = import.meta.glob<string>('../../../../packages/theme/src/themes/*.css', { eager: true, query: '?raw', import: 'default' });

const defaults = declarations(ruleBody(stripComments(knobsCss), /^:root\s*\{/m));
const order = ['void', 'orbit', 'capsule', 'aurora', 'iris', 'dune', 'paper', 'console'];
const presets = Object.entries(themeFiles)
  .map(([path, css]) => {
    const id = path.split('/').pop()!.replace('.css', '');
    // "/* Dune — warm, rounded, comfortable." is the first line of every theme file.
    const head = /\/\*\s*(\S+)\s+—\s+([^\n]+)/.exec(css);
    return { id, label: head?.[1] ?? id, blurb: (head?.[2] ?? '').replace(/\.$/, ''), values: readTheme(css) };
  })
  .sort((a, b) => (order.indexOf(a.id) + 99) % 99 - (order.indexOf(b.id) + 99) % 99);

const knob = (name: string) => knobs.find((k) => k.name === name)!;
const data = { defaults, presets: Object.fromEntries(presets.map((p) => [p.id, p.values])) };

const screens = [
  { id: 'overview', label: 'Overview' },
  { id: 'table', label: 'Table' },
  { id: 'form', label: 'Form' },
  { id: 'settings', label: 'Settings' },
  { id: 'live', label: 'Imagery' },
];

// The pairs the contrast readout shows. `on` and `fg` are colour tokens;
// `kind` is how the sample is drawn.
const pairs = [
  { id: 'text', label: 'Text', fg: 'text', on: 'bg', min: 4.5, kind: 'text' },
  { id: 'secondary', label: 'Secondary text', fg: 'text-secondary', on: 'bg', min: 4.5, kind: 'text' },
  { id: 'muted', label: 'Muted text', fg: 'text-muted', on: 'bg', min: 4.5, kind: 'text' },
  { id: 'card', label: 'Muted, on a card', fg: 'text-muted', on: 'surface', min: 4.5, kind: 'text' },
  { id: 'accent', label: 'Accent as text', fg: 'accent', on: 'bg', min: 4.5, kind: 'text' },
  { id: 'on-accent', label: 'On the accent', fg: 'text-on-accent', on: 'accent', min: 4.5, kind: 'text' },
  { id: 'error', label: 'Error text', fg: 'error', on: 'bg', min: 4.5, kind: 'text' },
  { id: 'success', label: 'Success text', fg: 'success', on: 'bg', min: 4.5, kind: 'text' },
  { id: 'control', label: 'Control border', fg: 'border-control', on: 'bg', min: 3, kind: 'border' },
  { id: 'focus', label: 'Focus ring', fg: 'border-focus', on: 'bg', min: 3, kind: 'border' },
];

const title = 'Theme builder · Voidable';
const description = 'Turn a dozen knobs and watch a real application change. Leave with a dozen lines of CSS, a link that carries every knob, a prompt for your agent and the tokens as DTCG JSON.';
const canonical = new URL('/theme/', Astro.site ?? 'https://voidable.dev').href;
const ogImage = new URL('/og.png', canonical).href;
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Voidable" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <script is:inline>
      // The site's own scheme, before first paint: the last choice, else the system's.
      try {
        const saved = localStorage.getItem('voidable-scheme');
        const scheme = saved ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', scheme);
      } catch {}
    </script>
  </head>
  <body>
    <a class="tb-skip" href="#tb-export">Skip to the export</a>
    <void-shell>
      <void-nav-bar sticky>
        <void-brand><a href="/">voidable</a></void-brand>
        <void-nav-links>
          <a href="/getting-started/introduction/">Docs</a>
          <a href="/theme/" aria-current="page">Theme builder</a>
          <a href="/getting-started/theming/">Theming</a>
          <a href="/patterns/overview/">Patterns</a>
          <a href="/storybook/">Components</a>
        </void-nav-links>
        <void-spacer></void-spacer>
        <void-button id="tb-scheme" variant="ghost" aria-label="Switch the site between dark and light">
          <span class="tb-icon tb-sun" set:html={iconSun} />
          <span class="tb-icon tb-moon" set:html={iconMoon} />
        </void-button>
        <void-nav-links data-void-hide="narrow">
          <a href="https://github.com/VoidableUI/Voidable" target="_blank" rel="noopener"><span class="tb-icon" set:html={iconBrandGithub} />GitHub</a>
        </void-nav-links>
      </void-nav-bar>

      <main class="tb">
        <header class="tb-head">
          <div class="tb-head-text">
            <span data-void-type="label">Theme builder</span>
            <h1>Turn a dozen knobs. Leave with a theme.</h1>
            <p data-void-type="lede">A real application, restyled live by the dozen inputs every Voidable theme is made of.</p>
          </div>
          <void-actions class="tb-head-actions">
            <void-button id="tb-surprise"><span class="tb-icon" set:html={iconDice} />Surprise me</void-button>
            <void-button id="tb-copy-link" class="tb-wide-only"><span class="tb-icon" set:html={iconLink} /><span data-label>Copy link</span></void-button>
            <void-button id="tb-copy-css" variant="filled"><span class="tb-icon" set:html={iconCopy} /><span data-label>Copy CSS</span></void-button>
          </void-actions>
        </header>

        <div class="tb-work">
          <!-- ── Controls ── -->
          <aside class="tb-rail" aria-label="Theme controls">
            <section class="tb-group">
              <div class="tb-group-head">
                <h2 data-void-type="label">Start from</h2>
                <void-button id="tb-reset" variant="ghost" size="sm"><span class="tb-icon" set:html={iconReset} />Reset</void-button>
              </div>
              <div class="tb-presets">
                {presets.map((p) => (
                  <void-button class="tb-preset" data-preset={p.id} title={p.blurb} aria-pressed="false">
                    <span class="tb-swatch" data-void-theme={p.id} aria-hidden="true"><span></span></span>
                    {p.label}
                  </void-button>
                ))}
                {skins.map((s) => (
                  <void-button class="tb-preset" data-preset-skin={s.id} title={s.description} aria-pressed="false">
                    <span class="tb-swatch tb-swatch-skin" data-void-theme data-void-skin={s.id} aria-hidden="true"><span></span></span>
                    {s.label}
                  </void-button>
                ))}
              </div>
            </section>

            <section class="tb-group">
              <h2 data-void-type="label">Colour</h2>
              <div class="tb-sub">
                <h3>Accent</h3>
                <p id="tb-accent-note" data-void-type="caption">Primary actions, selection and focus.</p>
              </div>
              <div class="tb-knob tb-strip tb-strip-hue" data-row="--void-accent-hue">
                <void-field label="Hue"><void-slider data-knob="--void-accent-hue" min="0" max="360" step="1"></void-slider></void-field>
                <output data-out="--void-accent-hue"></output>
              </div>
              <div class="tb-knob tb-strip tb-strip-chroma" data-row="--void-accent-chroma">
                <void-field label="Vividness"><void-slider data-knob="--void-accent-chroma" min={knob('--void-accent-chroma').min} max={knob('--void-accent-chroma').max} step={knob('--void-accent-chroma').step}></void-slider></void-field>
                <output data-out="--void-accent-chroma"></output>
              </div>
              <div class="tb-sub">
                <h3>Neutrals</h3>
                <p data-void-type="caption">The tint of text, lines and surfaces.</p>
              </div>
              <div class="tb-knob tb-strip tb-strip-nhue" data-row="--void-neutral-hue">
                <void-field label="Hue"><void-slider data-knob="--void-neutral-hue" min="0" max="360" step="1"></void-slider></void-field>
                <output data-out="--void-neutral-hue"></output>
              </div>
              <div class="tb-knob tb-strip tb-strip-nchroma" data-row="--void-neutral-chroma">
                <void-field label="Tint"><void-slider data-knob="--void-neutral-chroma" min="0" max={knob('--void-neutral-chroma').max} step={knob('--void-neutral-chroma').step}></void-slider></void-field>
                <output data-out="--void-neutral-chroma"></output>
              </div>
              <div class="tb-sub">
                <h3>Page</h3>
              </div>
              {[
                { name: '--void-page-tint', label: 'Page tint', hint: 'Pure black or white, to soft paper.' },
                { name: '--void-contrast', label: 'Contrast', hint: 'Secondary text and control borders. Never below AA.' },
                { name: '--void-chrome', label: 'Chrome', hint: 'Divider lines and container fills.' },
              ].map((k) => (
                <div class="tb-knob" data-row={k.name} title={k.hint}>
                  <void-field label={k.label}><void-slider data-knob={k.name} min={knob(k.name).min} max={knob(k.name).max} step={knob(k.name).step}></void-slider></void-field>
                  <output data-out={k.name}></output>
                </div>
              ))}
            </section>

            <section class="tb-group">
              <h2 data-void-type="label">Shape</h2>
              <div class="tb-knob" data-row="--void-radius">
                <void-field label="Corner radius"><void-slider data-knob="--void-radius" min="0" max="20" step="1"></void-slider></void-field>
                <output data-out="--void-radius"></output>
              </div>
              <void-switch id="tb-pill" class="tb-switch">Pill-shaped controls</void-switch>
              <void-field label="Structure" helper="A skin changes structure with role and component tokens: what a container is, where the lines are. It combines with any knobs.">
                <void-segmented-control id="tb-skin" value="none" aria-label="Structure">
                  <void-segmented-control-item value="none">Hairline</void-segmented-control-item>
                  {skins.map((s) => <void-segmented-control-item value={s.id}>{s.label}</void-segmented-control-item>)}
                </void-segmented-control>
              </void-field>
            </section>

            <section class="tb-group">
              <h2 data-void-type="label">Space</h2>
              {[
                { name: '--void-density', label: 'Density', hint: 'The size of controls and the space inside components.' },
                { name: '--void-rhythm', label: 'Rhythm', hint: 'The space between groups and sections.' },
              ].map((k) => (
                <div class="tb-knob" data-row={k.name} title={k.hint}>
                  <void-field label={k.label}><void-slider data-knob={k.name} min={knob(k.name).min} max={knob(k.name).max} step={knob(k.name).step}></void-slider></void-field>
                  <output data-out={k.name}></output>
                </div>
              ))}
            </section>

            <section class="tb-group">
              <h2 data-void-type="label">Type</h2>
              <void-field label="Typeface">
                <void-select data-font="--void-font-sans">
                  <select>
                    {Object.entries(fontStacks['--void-font-sans']).map(([key, f]) => <option value={key}>{f.label}</option>)}
                    <option value="custom" hidden>Custom</option>
                  </select>
                </void-select>
              </void-field>
              <void-field label="Monospace" helper="Labels, code and ids.">
                <void-select data-font="--void-font-mono">
                  <select>
                    {Object.entries(fontStacks['--void-font-mono']).map(([key, f]) => <option value={key}>{f.label}</option>)}
                    <option value="custom" hidden>Custom</option>
                  </select>
                </void-select>
              </void-field>
              <div class="tb-knob" data-row="--void-font-size">
                <void-field label="Text size"><void-slider data-knob="--void-font-size" min={knob('--void-font-size').min} max={knob('--void-font-size').max} step={knob('--void-font-size').step}></void-slider></void-field>
                <output data-out="--void-font-size"></output>
              </div>
            </section>

            <section class="tb-group">
              <h2 data-void-type="label">Motion</h2>
              <div class="tb-knob" data-row="--void-anim-scale">
                <void-field label="Animation" helper="Your system's reduced-motion setting always wins."><void-slider data-knob="--void-anim-scale" min="0" max="2" step="0.1"></void-slider></void-field>
                <output data-out="--void-anim-scale"></output>
              </div>
            </section>
          </aside>

          <!-- ── Preview ── -->
          <section class="tb-stage" aria-label="Preview">
            <void-toolbar class="tb-bar">
              <void-segmented-control id="tb-screen" value="overview" aria-label="Screen">
                {screens.map((s) => <void-segmented-control-item value={s.id}>{s.label}</void-segmented-control-item>)}
              </void-segmented-control>
              <void-spacer></void-spacer>
              <void-segmented-control id="tb-device" value="desktop" aria-label="Width" class="tb-wide-only">
                <void-segmented-control-item value="desktop">Desktop</void-segmented-control-item>
                <void-segmented-control-item value="phone">Phone</void-segmented-control-item>
              </void-segmented-control>
              <void-segmented-control id="tb-view" value="both" aria-label="Colour scheme">
                <void-segmented-control-item value="dark">Dark</void-segmented-control-item>
                <void-segmented-control-item value="light">Light</void-segmented-control-item>
                <void-segmented-control-item value="both" class="tb-wide-only">Both</void-segmented-control-item>
              </void-segmented-control>
            </void-toolbar>

            <div class="tb-canvas" id="tb-canvas" data-device="desktop" data-view="both">
              <div class="tb-frames" id="tb-frames"></div>
            </div>

            <section class="tb-contrast" aria-labelledby="tb-contrast-title">
              <div class="tb-contrast-head">
                <h2 id="tb-contrast-title" data-void-type="label">Contrast, measured now</h2>
                <void-badge id="tb-contrast-badge" variant="outline" color="success">Checking</void-badge>
              </div>
              <ul class="tb-pairs">
                {pairs.map((p) => (
                  <li class="tb-pair" data-pair={p.id} data-fg={p.fg} data-on={p.on} data-min={p.min} data-kind={p.kind}>
                    <span class="tb-samples" aria-hidden="true">
                      <span class="tb-sample" data-scheme="dark">{p.kind === 'text' ? 'Aa' : ''}</span>
                      <span class="tb-sample" data-scheme="light">{p.kind === 'text' ? 'Aa' : ''}</span>
                    </span>
                    <span class="tb-pair-text">
                      <span class="tb-pair-name">{p.label}</span>
                      <span class="tb-pair-ratio" data-void-type="code"><span data-ratio="dark">–</span> · <span data-ratio="light">–</span></span>
                    </span>
                  </li>
                ))}
              </ul>
              <p data-void-type="caption">Contrast ratios in dark, then in light, measured from the colours the browser computed for these knobs. Text needs 4.5:1 and the two borders 3:1 (WCAG AA). The same arithmetic runs in CI over every theme and the extremes of every knob (<code>lint:contrast</code>), which is why no setting here can fail.</p>
            </section>
          </section>
        </div>

        <!-- ── Export ── -->
        <section class="tb-export" id="tb-export" aria-labelledby="tb-export-title" tabindex="-1">
          <void-section-head>
            <h2 id="tb-export-title">Take it with you</h2>
            <p>This is the whole theme. Nothing else is generated: the rest is derived from these lines by the stylesheet you already load.</p>
          </void-section-head>

          <div class="tb-export-grid">
            <void-tabs id="tb-tabs" value="css" class="tb-tabs">
              <void-tabs-list>
                <void-tabs-trigger value="css">theme.css</void-tabs-trigger>
                <void-tabs-trigger value="link">Link</void-tabs-trigger>
                <void-tabs-trigger value="prompt">Prompt</void-tabs-trigger>
                <void-tabs-trigger value="tokens">Design tokens</void-tabs-trigger>
              </void-tabs-list>
              <void-tabs-content value="css">
                <pre class="tb-code" tabindex="0" aria-label="Theme CSS"><code id="tb-css"></code></pre>
                <void-actions>
                  <void-button id="tb-copy-css-2" variant="filled"><span class="tb-icon" set:html={iconCopy} /><span data-label>Copy CSS</span></void-button>
                  <void-button id="tb-download-css"><span class="tb-icon" set:html={iconDownload} />Download <span id="tb-filename">theme.css</span></void-button>
                </void-actions>
              </void-tabs-content>
              <void-tabs-content value="link">
                <void-field label="A link to this theme" helper="Every knob is a parameter named after it (--void-radius is radius), so a person or an agent can also write this link by hand.">
                  <void-input id="tb-url" readonly></void-input>
                </void-field>
                <void-actions>
                  <void-button id="tb-copy-link-2" variant="filled"><span class="tb-icon" set:html={iconLink} /><span data-label>Copy link</span></void-button>
                </void-actions>
              </void-tabs-content>
              <void-tabs-content value="prompt">
                <p class="tb-prompt" id="tb-prompt" tabindex="0"></p>
                <void-actions>
                  <void-button id="tb-copy-prompt" variant="filled"><span class="tb-icon" set:html={iconCopy} /><span data-label>Copy prompt</span></void-button>
                </void-actions>
              </void-tabs-content>
              <void-tabs-content value="tokens">
                <p class="tb-note">The knobs, or every token they resolve to, as <a href="https://www.designtokens.org/TR/2025.10/format/">Design Tokens Community Group</a> JSON (format {DTCG_VERSION}) for Tokens Studio, Style Dictionary and other design tools. Colours are sRGB with a hex fallback.</p>
                <void-actions>
                  <void-button id="tb-dtcg-knobs"><span class="tb-icon" set:html={iconDownload} />Knobs</void-button>
                  <void-button id="tb-dtcg-dark"><span class="tb-icon" set:html={iconDownload} />Resolved, dark</void-button>
                  <void-button id="tb-dtcg-light"><span class="tb-icon" set:html={iconDownload} />Resolved, light</void-button>
                </void-actions>
                <p class="tb-note">The shipped themes are already exported in the package: <code>@voidable/theme/dtcg/dune.light.tokens.json</code>.</p>
              </void-tabs-content>
            </void-tabs>

            <void-stack class="tb-use">
              <void-field label="Name" helper="Optional. A named theme applies where you put data-void-theme; without a name it applies to the whole page.">
                <void-input id="tb-name" placeholder="acme"></void-input>
              </void-field>
              <div>
                <span data-void-type="label">Use it</span>
                <pre class="tb-code tb-code-quiet" tabindex="0" aria-label="How to use the theme"><code id="tb-usage"></code></pre>
              </div>
            </void-stack>
          </div>
        </section>
      </main>

      <footer class="tb-foot">
        <void-nav-links>
          <a href="/getting-started/theming/">What each knob does</a>
          <a href="/getting-started/theming/#skins">Skins</a>
          <a href="/getting-started/theming/#tokens-for-design-tools">Tokens for design tools</a>
          <a href="/storybook/">Storybook</a>
        </void-nav-links>
        <span data-void-type="caption">voidable.dev · MIT</span>
      </footer>
    </void-shell>

    <!-- Probes for the contrast readout: a themed region per scheme. -->
    <div class="tb-probes" aria-hidden="true">
      <div id="tb-probe-dark" data-void-theme data-theme="dark"></div>
      <div id="tb-probe-light" data-void-theme data-theme="light"></div>
    </div>
    <div class="tb-live" id="tb-live" role="status" aria-live="polite"></div>
    <script type="application/json" id="tb-data" set:html={JSON.stringify(data)} />

    <script>
      import * as ui from '@voidable/ui';
      import { start } from '../../lib/theme-builder';
      document.documentElement.dataset.voidElements = String(Object.keys(ui).length);
      // Development warnings, `astro dev` only.
      if (import.meta.env.DEV) import('@voidable/ui/dev');
      start();
    </script>

    <style is:global>
      html {
        /* The workspace is wider than a reading page; the bar lines up with it. */
        --void-measure-page: 100rem;
        font-family: var(--void-font-sans);
        color: var(--void-color-text);
        background: var(--void-color-bg);
        scroll-padding-top: var(--void-space-16);
      }

      .tb-skip {
        position: absolute;
        inset: var(--void-space-2) auto auto var(--void-space-2);
        z-index: var(--void-z-tooltip);
        padding: var(--void-space-2) var(--void-space-3);
        background: var(--void-color-bg-elevated);
        border-radius: var(--void-radius-md);
        box-shadow: var(--void-ring-hair), var(--void-shadow-md);
        transform: translateY(-200%);
      }
      .tb-skip:focus-visible { transform: none; }

      .tb-icon {
        display: inline-flex;
        width: 1rem;
        height: 1rem;
        flex: none;
      }
      .tb-icon svg { width: 100%; height: 100%; }
      void-nav-links > a:has(.tb-icon) { display: inline-flex; align-items: center; gap: var(--void-space-2); }
      [data-theme="dark"] .tb-moon, [data-theme="light"] .tb-sun { display: none; }

      /* One column, wider than a reading page: this is a workspace. */
      .tb {
        --tb-rail: 20rem;
        box-sizing: border-box;
        width: 100%;
        max-width: 100rem;
        margin-inline: auto;
        padding: var(--void-gap-stack) var(--void-gutter) var(--void-gap-section);
        display: flex;
        flex-direction: column;
        gap: var(--void-gap-stack);
      }

      .tb-head {
        display: flex;
