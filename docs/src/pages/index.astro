---
import '@voidable/theme';
import '../../../packages/theme/src/themes/void.css';
import '../../../packages/theme/src/themes/dune.css';
import '../../../packages/theme/src/themes/console.css';
import voidThemeCss from '../../../packages/theme/src/themes/void.css?raw';
import duneThemeCss from '../../../packages/theme/src/themes/dune.css?raw';
import consoleThemeCss from '../../../packages/theme/src/themes/console.css?raw';
import iconBrandGithub from '@tabler/icons/outline/brand-github.svg?raw';
import iconSun from '@tabler/icons/outline/sun.svg?raw';
import iconMoon from '@tabler/icons/outline/moon.svg?raw';
import ThemeDemo from '../components/ThemeDemo.astro';
import { stats } from '../lib/stats';

// The three demonstration themes are shown as their real source: the knob
// declarations are read from the theme files, so this page cannot drift.
const knobLines = (css: string) =>
  [...css.matchAll(/^\s*(--void-[\w-]+):\s*([^;]+);/gm)].map(([, name, value]) => ({ name, value: value.trim() }));
const themes = [
  { id: 'void', label: 'Void', blurb: 'The default: monochrome, hairlines, 4px corners.', knobs: knobLines(voidThemeCss) },
  { id: 'dune', label: 'Dune', blurb: 'Warm, rounded, comfortable, on a soft page.', knobs: knobLines(duneThemeCss) },
  { id: 'console', label: 'Console', blurb: 'Dense, square, monospace, signal green.', knobs: knobLines(consoleThemeCss) },
];

const esc = (text: string) => text.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const sourceOf = (t: (typeof themes)[number]) =>
  `[data-void-theme="${t.id}"] {\n` +
  t.knobs.map((k) => `  ${k.name}: <span class="v">${esc(k.value)}</span>;`).join('\n') +
  '\n}';

// Counts, version and bundle size are derived at build time (see src/lib/stats.ts).
const { version, bundleSize } = stats;
const description = `Framework-agnostic web component library built with Lit 3. ${stats.elements} custom elements, Light DOM, zero visual CSS, token theming. ${stats.adapters} adapter packages for React, Vue, Solid, Svelte, Angular, Hotwire, Alpine, and LiveView, plus guides for Lit, Qwik, Astro, and vanilla JS.`;
const siteTitle = 'Voidable. Devoid of style.';
const canonical = new URL('/', Astro.site ?? 'https://voidable.dev').href;
const ogImage = new URL('/og.png', canonical).href;
---

<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Voidable. Devoid of style.</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Voidable" />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={siteTitle} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }

      /* Only the elements a browser gives a margin or padding of its own.
         A reset of `*` is outside the theme's cascade layers and so beats
         them: it took the padding off every void-button and every media
         surface on this page. */
      body, h1, h2, h3, h4, p, ul, ol, dl, dd, pre, figure, blockquote {
        margin: 0;
        padding: 0;
      }

      html {
        font-family: var(--void-font-sans);
        color: var(--void-color-text);
        background: var(--void-color-bg);
      }

      body {
        min-height: 100dvh;
        line-height: var(--void-leading-normal);
        overflow-x: hidden;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      /* One column for the whole page: every section lines up on it. */
      .container {
        max-width: calc(var(--void-measure-page) + 2 * var(--void-gutter));
        margin: 0 auto;
        padding: 0 var(--void-gutter);
      }

      .section {
        padding: var(--void-space-30) 0;
        border-top: 1px solid var(--void-color-border);
      }

      .eyebrow {
        font-family: var(--void-type-label-family);
        font-size: var(--void-type-label-size);
        font-weight: var(--void-type-label-weight);
        text-transform: var(--void-type-label-case);
        letter-spacing: var(--void-type-label-tracking);
        color: var(--void-type-label-color);
        margin-bottom: var(--void-space-4);
      }

      .section-heading {
        font-size: clamp(2rem, 4.2vw, 3rem);
        font-weight: var(--void-weight-medium);
        letter-spacing: var(--void-tracking-tighter);
        line-height: var(--void-leading-snug);
        color: var(--void-color-text);
      }

      .section-sub {
        font-size: var(--void-text-md);
        color: var(--void-color-text-secondary);
        line-height: var(--void-leading-relaxed);
        margin-top: var(--void-space-5);
        max-width: var(--void-measure);
      }

      .section-sub code {
        font-family: var(--void-font-mono);
        font-size: 0.875em;
        color: var(--void-color-text);
      }

      .section-header {
        margin-bottom: var(--void-space-16);
      }

      /* ── Nav ── */
      .nav {
        position: sticky;
        top: 0;
        z-index: 50;
        background: color-mix(in srgb, var(--void-color-bg) 86%, transparent);
        backdrop-filter: saturate(140%) blur(6px);
        -webkit-backdrop-filter: saturate(140%) blur(6px);
        border-bottom: 1px solid var(--void-color-border);
        transition: background var(--void-duration-normal) var(--void-ease-in-out),
                    border-color var(--void-duration-normal) var(--void-ease-in-out);
      }

      /* Over the hero the bar is part of the photograph: no fill, no rule,
         and dark-scheme ink in both schemes (the script below the hero puts
         data-theme="dark" on it while the hero is under it). In light mode
         it used to be a white strip butted against a black image. The hero
         slides up under the bar, so the image starts at the top of the
         screen. Without the script nothing here applies and the bar is the
         page's, as it is past the hero. */
      .nav[data-over-hero] {
        background: transparent;
        border-bottom-color: transparent;
        backdrop-filter: none;
        -webkit-backdrop-filter: none;
      }

      :global(html[data-nav-overlays]) .hero {
        margin-top: calc(var(--nav-height, 3.5rem) * -1);
        --void-media-height: max(40rem, 100svh);
      }

      .nav-inner {
        display: flex;
        align-items: center;
        gap: var(--void-space-7);
        padding: var(--void-space-3) 0;
      }

      .nav-wordmark {
        font-family: var(--void-font-mono);
        font-weight: var(--void-weight-medium);
        font-size: var(--void-text-md);
        letter-spacing: var(--void-tracking-tight);
        color: var(--void-color-text);
      }

      .nav-links {
        display: flex;
        gap: var(--void-space-1);
        list-style: none;
      }

      .nav-links a {
        display: block;
        padding: var(--void-space-1h) var(--void-space-3);
        font-size: var(--void-text-base);
        color: var(--void-color-text-secondary);
        border-radius: var(--void-radius-md);
        transition: color var(--void-duration-fast);
      }

      .nav-links a:hover {
        color: var(--void-color-text);
      }

      .nav-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: var(--void-space-1);
      }

      .nav-github-icon,
      .theme-icon {
        display: flex;
        width: var(--void-space-4);
        height: var(--void-space-4);
      }
      .nav-github-icon :global(svg),
      .theme-icon :global(svg) {
        width: 100%;
        height: 100%;
      }
      [data-theme="dark"] .theme-icon-sun { display: flex; }
      [data-theme="dark"] .theme-icon-moon { display: none; }
      [data-theme="light"] .theme-icon-sun { display: none; }
      [data-theme="light"] .theme-icon-moon { display: flex; }

      @media (max-width: 720px) {
        .nav-links {
          display: none;
        }
      }

      /* ── Hero ──
         A media surface (void-media): the Earth's limb from orbit, a line of
         light in a black sky, low in the frame like a horizon under the
         headline. The photograph is black wherever the text sits, so the
         surface needs no scrim; the text is off-white in both colour
         schemes because it is on the image, not on the page. */
      .hero {
        --void-media-height: max(40rem, calc(100svh - 3.5rem));
        --void-media-focal: 50% 100%;
      }

      /* The children below carry their own spacing. */
      .hero-content {
        gap: 0;
        padding-block: var(--void-space-12) var(--void-space-35);
      }

      .hero-credit {
        position: absolute;
        z-index: 1;
        inset: auto var(--void-gutter) var(--void-space-4) auto;
        font-family: var(--void-font-mono);
        font-size: var(--void-text-2xs);
        color: var(--void-color-text-muted);
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: var(--void-space-2h);
        padding: var(--void-space-1) var(--void-space-4) var(--void-space-1) var(--void-space-1);
        border: 1px solid var(--void-color-border);
        border-radius: var(--void-radius-full);
        font-size: var(--void-text-xs);
        color: var(--void-color-text-secondary);
        margin-bottom: var(--void-space-10);
      }

      /* With no version to show, the badge is padded evenly. */
      .hero-badge:not(:has(.hero-badge-version)) {
        padding-inline: var(--void-space-4);
      }

      .hero-badge-version {
        padding: 0.0625rem var(--void-space-2);
        background: var(--void-color-bg-hover);
        border-radius: var(--void-radius-full);
        font-family: var(--void-font-mono);
        font-size: var(--void-text-2xs);
        color: var(--void-color-text);
      }

      .hero h1 {
        font-weight: var(--void-weight-medium);
        font-size: clamp(3.25rem, 9.5vw, 8rem);
        letter-spacing: var(--void-tracking-tightest);
        line-height: var(--void-leading-display);
        color: var(--void-color-text);
        margin-bottom: var(--void-space-9);
      }

      .hero-sub {
        font-size: var(--void-text-lg);
        color: var(--void-color-text-secondary);
        line-height: var(--void-leading-relaxed);
        max-width: 36rem;
        margin: 0 auto var(--void-space-10);
      }

      .install-pill {
        display: inline-flex;
        align-items: center;
        gap: var(--void-space-2);
        padding: var(--void-space-2h) var(--void-space-4);
        border: 1px solid var(--void-color-border);
        border-radius: var(--void-radius-md);
        font-family: var(--void-font-mono);
        font-size: var(--void-text-sm);
        color: var(--void-color-text-secondary);
        margin-bottom: var(--void-space-8);
        background: transparent;
        cursor: pointer;
        transition: color var(--void-duration-fast), border-color var(--void-duration-fast);
      }

      .install-pill:hover {
        color: var(--void-color-text);
        border-color: var(--void-color-border-strong);
      }

      .install-pill-dollar {
        color: var(--void-color-text-muted);
      }

      .hero-actions,
      .cta-actions {
        display: flex;
        gap: var(--void-space-3);
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
      }

      /* ── Frameworks ── */
      .frameworks {
        padding: var(--void-space-12) 0;
        border-top: 1px solid var(--void-color-border);
        text-align: center;
      }

      .framework-list {
        display: flex;
        gap: var(--void-space-1) var(--void-space-2);
        justify-content: center;
        flex-wrap: wrap;
      }

      .framework-pill {
        padding: var(--void-space-1h) var(--void-space-3);
        font-size: var(--void-text-base);
        color: var(--void-color-text-secondary);
        border-radius: var(--void-radius-md);
        transition: color var(--void-duration-fast), background var(--void-duration-fast);
      }

      a.framework-pill:hover {
        color: var(--void-color-text);
        background: var(--void-color-bg-hover);
      }

      /* ── Feature grid: cells divided by hairlines, no box ── */
      .feature-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        column-gap: var(--void-gap-group);
        border-top: 1px solid var(--void-color-border);
      }

      .feature-card {
        padding: var(--void-space-8) 0;
        border-bottom: 1px solid var(--void-color-border);
      }

      .feature-card-title {
        font-weight: var(--void-weight-medium);
        font-size: var(--void-text-md);
        color: var(--void-color-text);
        margin-bottom: var(--void-space-2);
      }

      .feature-card-desc {
        font-size: var(--void-text-base);
        color: var(--void-color-text-secondary);
        line-height: var(--void-leading-relaxed);
      }

      @media (max-width: 900px) {
        .feature-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 560px) {
        .feature-grid {
          grid-template-columns: 1fr;
        }
      }

      /* ── Theming: pick a theme, read its source, watch it apply ── */
      .theme-grid {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        gap: var(--void-space-16);
        align-items: start;
      }

      .theme-picker {
        display: flex;
        flex-direction: column;
        gap: var(--void-gap-inside);
        margin-top: var(--void-space-10);
      }

      .theme-picker void-segmented-control {
        align-self: flex-start;
      }

      .theme-blurb {
        font-size: var(--void-text-base);
        color: var(--void-color-text-secondary);
      }

      .theme-source {
        margin: 0;
        padding: var(--void-space-5) 0;
        border-top: 1px solid var(--void-color-border);
        border-bottom: 1px solid var(--void-color-border);
        font-family: var(--void-font-mono);
        font-size: var(--void-text-sm);
        line-height: var(--void-leading-loose);
        color: var(--void-color-text-secondary);
        overflow-x: auto;
        white-space: pre;
      }

      .theme-source[hidden] {
        display: none;
      }

      .theme-source :global(.v) {
        color: var(--void-color-text);
      }

      .theme-note {
        font-size: var(--void-text-xs);
        color: var(--void-color-text-secondary);
        line-height: var(--void-leading-relaxed);
      }

      /* The demo is a themed region: it carries data-void-theme, so every
         token below it is derived again from that theme's knobs, and it
         paints its own page colour. */
      .themed {
        background: var(--void-color-bg);
        color: var(--void-color-text);
        font-family: var(--void-font-sans);
        font-size: var(--void-text-base);
        border: 1px solid var(--void-color-border);
        border-radius: var(--void-radius-xl);
        padding: var(--void-space-8);
        transition: background var(--void-duration-normal), border-color var(--void-duration-normal);
      }

      @media (max-width: 960px) {
        .theme-grid {
          grid-template-columns: 1fr;
          gap: var(--void-space-10);
        }
      }

      @media (max-width: 560px) {
        .themed {
          padding: var(--void-space-5);
        }
      }

      /* ── Components ── */
      .components-panel {
        display: flex;
        flex-direction: column;
        gap: var(--void-gap-group);
      }

      .component-row-label {
        font-family: var(--void-type-label-family);
        font-size: var(--void-type-label-size);
        font-weight: var(--void-type-label-weight);
        text-transform: var(--void-type-label-case);
        letter-spacing: var(--void-type-label-tracking);
        color: var(--void-type-label-color);
        margin-bottom: var(--void-space-4);
      }

      .component-row {
        display: flex;
        flex-wrap: wrap;
        gap: var(--void-gap-tight);
        align-items: center;
      }
      .component-row + .component-row {
        margin-top: var(--void-gap-tight);
      }

      .form-stepper {
        padding-bottom: var(--void-gap-stack);
      }
      .form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--void-gap-stack) var(--void-gap-inside);
      }
      .form-full {
        grid-column: 1 / -1;
      }
      .form-inline {
        display: flex;
        gap: var(--void-space-10);
        align-items: flex-end;
      }
      .form-actions {
        display: flex;
        gap: var(--void-gap-tight);
        justify-content: flex-end;
      }
      @media (max-width: 720px) {
        .form-grid {
          grid-template-columns: 1fr;
        }
        .form-inline {
          flex-wrap: wrap;
          gap: var(--void-space-6);
        }
      }

      /* ── Stats: figures on the page, divided by hairlines ── */
      .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
      }

      .stat-card {
        display: flex;
        flex-direction: column;
        gap: var(--void-space-3);
        padding: var(--void-space-2) var(--void-space-7);
      }

      .stat-card:first-child {
        padding-left: 0;
      }

      .stat-card + .stat-card {
        border-left: 1px solid var(--void-color-border);
      }

      .stat-number {
        font-family: var(--void-type-value-family);
        font-size: clamp(2.25rem, 4.5vw, 3.5rem);
        font-weight: var(--void-type-value-weight);
        letter-spacing: var(--void-type-value-tracking);
        font-variant-numeric: var(--void-type-value-numeric);
        line-height: var(--void-leading-none);
        color: var(--void-color-text);
        white-space: nowrap;
      }

      @media (max-width: 720px) {
        .stats-grid {
          grid-template-columns: repeat(2, 1fr);
          row-gap: var(--void-space-10);
        }
        .stat-card:nth-child(odd) {
          padding-left: 0;
          border-left: 0;
        }
      }

      /* ── CTA ── */
      .cta {
        padding: var(--void-space-35) 0;
        border-top: 1px solid var(--void-color-border);
        text-align: center;
      }

      .cta h2 {
        font-size: clamp(2.25rem, 5.5vw, 4rem);
        font-weight: var(--void-weight-medium);
        letter-spacing: var(--void-tracking-tighter);
        line-height: var(--void-leading-tight);
        color: var(--void-color-text);
        margin-bottom: var(--void-space-6);
      }

      .cta p {
        font-size: var(--void-text-md);
        color: var(--void-color-text-secondary);
        line-height: var(--void-leading-relaxed);
        max-width: 30rem;
        margin: 0 auto var(--void-space-10);
      }

      /* ── Footer ── */
      .footer {
        padding: var(--void-space-12) 0 var(--void-space-10);
        border-top: 1px solid var(--void-color-border);
      }

      .footer-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: var(--void-space-4);
        margin-bottom: var(--void-space-8);
      }

      .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--void-space-3) var(--void-space-7);
        list-style: none;
      }

      .footer-links a {
        font-size: var(--void-text-sm);
        color: var(--void-color-text-secondary);
        transition: color var(--void-duration-fast);
      }

      .footer-links a:hover {
        color: var(--void-color-text);
      }

      .footer-bottom {
        display: flex;
        justify-content: space-between;
        font-size: var(--void-text-xs);
        color: var(--void-color-text-muted);
        font-family: var(--void-font-mono);
      }
    </style>
  </head>
  <body>

    <!-- Nav -->
    <nav class="nav">
      <div class="container">
        <div class="nav-inner">
          <span class="nav-wordmark">voidable</span>
          <ul class="nav-links">
            <li><a href="/getting-started/introduction/">Docs</a></li>
            <li><a href="/theme/">Theme builder</a></li>
            <li><a href="/patterns/overview/">Patterns</a></li>
            <li><a href="/storybook/">Components</a></li>
            <li><a href="/showcase/dashboard">Showcase</a></li>
          </ul>
          <div class="nav-right">
            <void-button id="theme-toggle" variant="ghost" aria-label="Toggle theme">
              <span class="theme-icon theme-icon-sun" set:html={iconSun} />
              <span class="theme-icon theme-icon-moon" set:html={iconMoon} />
            </void-button>
            <void-button variant="ghost">
              <a href="https://github.com/VoidableUI/Voidable" target="_blank">
                <span class="nav-github-icon" set:html={iconBrandGithub} />
                GitHub
              </a>
            </void-button>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero -->
    <void-media class="hero" place="center" scrim="none">
      <img src="/media/limb-horizon.jpg" alt="" fetchpriority="high" />
      <void-media-content class="hero-content">
        <div class="hero-badge">
          {version && <span class="hero-badge-version">{version}</span>}
          {stats.adapters} framework adapter packages
        </div>
        <h1>Devoid<br/>of style.</h1>
        <p class="hero-sub">
          {stats.elements} Lit 3 custom elements with zero visual CSS.
          A light, airy theme you can make your own by changing a dozen values.
        </p>
        <div class="install-pill" id="install-pill">
          <span class="install-pill-dollar">$</span>
          npm i @voidable/ui @voidable/theme
        </div>
        <div class="hero-actions">
          <void-button variant="filled" size="lg"><a href="/getting-started/installation/">Get started</a></void-button>
          <void-button variant="outline" size="lg"><a href="/theme/">Make a theme</a></void-button>
        </div>
      </void-media-content>
      <a class="hero-credit" href="/patterns/ui-over-imagery/#the-photographs">Photograph: NASA</a>
    </void-media>
    <script is:inline>
      // The bar lies over the hero until the hero has scrolled out from
      // under it. Runs before first paint, so nothing flashes.
      (() => {
        const nav = document.querySelector('.nav');
        const hero = document.querySelector('.hero');
        if (!nav || !hero || !('IntersectionObserver' in window)) return;
        const set = (over) => {
          nav.toggleAttribute('data-over-hero', over);
          if (over) nav.setAttribute('data-theme', 'dark');
          else nav.removeAttribute('data-theme');
        };
        document.documentElement.style.setProperty('--nav-height', nav.offsetHeight + 'px');
        document.documentElement.setAttribute('data-nav-overlays', '');
        set(true);
        new IntersectionObserver(([entry]) => set(entry.isIntersecting), {
          rootMargin: `-${nav.offsetHeight}px 0px 0px 0px`,
        }).observe(hero);
      })();
    </script>

