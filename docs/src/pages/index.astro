    <script>
      import '@voidable/ui';
      // Development warnings, `astro dev` only.
      if (import.meta.env.DEV) import('@voidable/ui/dev');

      const html = document.documentElement;
      document.getElementById('theme-toggle')!.addEventListener('click', () => {
        html.setAttribute('data-theme', html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark');
      });

      // The theme picker sets data-void-theme on the themed regions and shows
      // that theme's source. Nothing else changes: the theme files do the rest.
      const picker = document.getElementById('theme-picker') as (HTMLElement & { value: string }) | null;
      picker?.addEventListener('void-change', () => {
        const theme = picker.value;
        document.querySelectorAll('[data-themed]').forEach((el) => el.setAttribute('data-void-theme', theme));
        document.querySelectorAll<HTMLElement>('[data-theme-panel]').forEach((el) => {
          el.hidden = el.dataset.themePanel !== theme;
        });
        // The builder opens on the theme being looked at.
        document.getElementById('theme-open')?.setAttribute('href', `/theme/?theme=${theme}`);
      });
    </script>
