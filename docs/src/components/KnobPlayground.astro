---
// Live knob playground for the theming guide. Each slider sets one theme
// knob on the preview, which carries data-void-theme, so everything in it is
// derived again. The CSS underneath is what to copy into a stylesheet.
import ThemeDemo from './ThemeDemo.astro';
import voidThemeCss from '../../../packages/theme/src/themes/void.css?raw';
import duneThemeCss from '../../../packages/theme/src/themes/dune.css?raw';
import consoleThemeCss from '../../../packages/theme/src/themes/console.css?raw';

const knobsOf = (css: string) =>
  Object.fromEntries([...css.matchAll(/^\s*(--void-[\w-]+):\s*([^;]+);/gm)].map(([, name, value]) => [name, value.trim()]));
const presets = { void: knobsOf(voidThemeCss), dune: knobsOf(duneThemeCss), console: knobsOf(consoleThemeCss) };

const knobs = [
  { name: '--void-accent-hue', label: 'Accent hue', min: 0, max: 360, step: 1, unit: '' },
  { name: '--void-accent-chroma', label: 'Accent chroma', min: 0, max: 0.25, step: 0.01, unit: '' },
  { name: '--void-neutral-hue', label: 'Neutral hue', min: 0, max: 360, step: 1, unit: '' },
  { name: '--void-neutral-chroma', label: 'Neutral chroma', min: 0, max: 0.04, step: 0.001, unit: '' },
  { name: '--void-page-tint', label: 'Page tint', min: 0, max: 1, step: 0.05, unit: '' },
  { name: '--void-contrast', label: 'Contrast', min: 0, max: 1, step: 0.05, unit: '' },
  { name: '--void-chrome', label: 'Chrome', min: 0, max: 1, step: 0.05, unit: '' },
  { name: '--void-radius', label: 'Radius', min: 0, max: 20, step: 1, unit: 'px' },
  { name: '--void-density', label: 'Density', min: 0.75, max: 1.25, step: 0.01, unit: '' },
  { name: '--void-rhythm', label: 'Rhythm', min: 0.6, max: 1.4, step: 0.05, unit: '' },
  { name: '--void-font-size', label: 'Font size', min: 0.75, max: 1, step: 0.0625, unit: 'rem' },
];
---

<div class="playground not-content" data-knob-playground data-presets={JSON.stringify(presets)}>
  <div class="playground-controls">
    <div class="playground-presets">
      <span data-void-type="label">Start from</span>
      <void-button size="sm" variant="ghost" data-preset="void">Void</void-button>
      <void-button size="sm" variant="ghost" data-preset="dune">Dune</void-button>
      <void-button size="sm" variant="ghost" data-preset="console">Console</void-button>
    </div>
    {knobs.map((k) => (
      <label class="playground-knob">
        <span class="playground-knob-name">{k.label}</span>
        <input type="range" min={k.min} max={k.max} step={k.step} data-knob={k.name} data-unit={k.unit} />
        <output class="playground-knob-value"></output>
      </label>
    ))}
  </div>

  <div class="playground-preview" data-void-theme data-preview>
    <ThemeDemo />
  </div>

  <pre class="playground-css"><code data-css></code></pre>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-knob-playground]')) {
    const presets = JSON.parse(root.dataset.presets!) as Record<string, Record<string, string>>;
    const preview = root.querySelector<HTMLElement>('[data-preview]')!;
    const css = root.querySelector<HTMLElement>('[data-css]')!;
    const inputs = [...root.querySelectorAll<HTMLInputElement>('input[data-knob]')];
    // Knobs the sliders do not cover (the font families) pass through from the preset.
    let extra: Record<string, string> = {};

    const render = () => {
      const lines: string[] = [];
      preview.removeAttribute('style');
      for (const input of inputs) {
        const value = `${input.value}${input.dataset.unit}`;
        preview.style.setProperty(input.dataset.knob!, value);
        (input.nextElementSibling as HTMLOutputElement).value = value;
        lines.push(`  ${input.dataset.knob}: ${value};`);
      }
      for (const [name, value] of Object.entries(extra)) {
        preview.style.setProperty(name, value);
        lines.push(`  ${name}: ${value};`);
      }
      css.textContent = `:root {\n${lines.join('\n')}\n}`;
    };

    const load = (name: string) => {
      const preset = { ...presets.void, ...presets[name] };
      extra = {};
      for (const [knob, value] of Object.entries(preset)) {
        const input = inputs.find((i) => i.dataset.knob === knob);
        if (input) input.value = String(parseFloat(value));
        else if (name !== 'void') extra[knob] = value;
      }
      render();
    };

    for (const input of inputs) input.addEventListener('input', render);
    for (const button of root.querySelectorAll<HTMLElement>('[data-preset]')) {
      button.addEventListener('click', () => load(button.dataset.preset!));
    }
    load('void');
  }
</script>

<style>
  .playground {
    display: flex;
    flex-direction: column;
    gap: var(--void-gap-stack);
    margin-block: var(--void-gap-stack);
  }

  .playground-controls {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--void-space-4) var(--void-gap-inside);
  }

  .playground-presets {
    display: flex;
    align-items: center;
    gap: var(--void-space-1);
    flex-wrap: wrap;
    grid-column: 1 / -1;
  }

  .playground-presets [data-void-type] {
    margin-right: var(--void-space-2);
  }

  .playground-knob {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--void-space-1) var(--void-space-3);
    font-size: var(--void-text-sm);
    color: var(--void-color-text-secondary);
  }

  .playground-knob input {
    grid-column: 1 / -1;
    grid-row: 2;
    width: 100%;
    margin: 0;
    accent-color: var(--void-color-text);
  }

  .playground-knob-value {
    font-family: var(--void-font-mono);
    font-size: var(--void-text-xs);
    font-variant-numeric: tabular-nums;
    color: var(--void-color-text);
  }

  /* The preview is a themed region and paints its own page colour. */
  .playground-preview {
    background: var(--void-color-bg);
    color: var(--void-color-text);
    font-family: var(--void-font-sans);
    font-size: var(--void-text-base);
    border: 1px solid var(--void-color-border);
    border-radius: var(--void-radius-xl);
    padding: var(--void-space-6);
    min-width: 0;
  }

  .playground-css {
    margin: 0;
    padding: var(--void-space-4) 0;
    border: 0;
    border-top: 1px solid var(--void-color-border);
    border-bottom: 1px solid var(--void-color-border);
    background: transparent;
    font-family: var(--void-font-mono);
    font-size: var(--void-text-sm);
    line-height: var(--void-leading-loose);
    color: var(--void-color-text);
    overflow-x: auto;
  }
</style>
