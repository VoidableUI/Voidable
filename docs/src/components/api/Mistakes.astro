---
// Generated from the manifest (voidHints, value sets, boolean rules, parent and
// child rules) and the checker's rules, so every line is something
// `voidable check` or `@voidable/ui/dev` would also say.
import { Code } from '@astrojs/starlight/components';
import { loadComponentData, commonMistakes } from '../../lib/component-data.mjs';
import { inline } from '../../lib/inline.mjs';

interface Props { tag: string }
const { tag } = Astro.props;
const c = loadComponentData().byTag.get(tag)!;
const items = commonMistakes(c);
---

<dl class="vd-api-mistakes">
  {
    items.map((m: any) => (
      <Fragment>
        <dt><code>{m.wrong}</code></dt>
        <dd set:html={inline(m.why)} />
      </Fragment>
    ))
  }
</dl>
