# Check out text files with LF on every platform. Windows runners otherwise check out
# CRLF, and the build scripts that parse CSS comments and markup line by line then
# read every line with a trailing carriage return.
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.webp binary
*.ico binary
*.woff2 binary
*.gem binary
*.tgz binary
