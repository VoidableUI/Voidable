#!/usr/bin/env bash
#MISE description="Cross-compile voidable for linux/amd64, linux/arm64, darwin/arm64, windows/amd64 (local only, nothing is published)"
#MISE depends=["build:manifest"]
set -euo pipefail

cd "$(dirname "$0")/../../.."
version="$(sed -n 's/.*"version": *"\([^"]*\)".*/\1/p' internal/infra/embedded/data/manifest/components.json | head -1)"
for target in linux/amd64 linux/arm64 darwin/arm64 windows/amd64; do
  os="${target%/*}" arch="${target#*/}"
  ext=""; [[ "$os" == windows ]] && ext=".exe"
  out="build/cross/voidable-${os}-${arch}${GO_TAGS:+-$GO_TAGS}${ext}"
  CGO_ENABLED=0 GOOS="$os" GOARCH="$arch" go build -trimpath \
    -ldflags="-s -w -X main.Version=${version:-dev}" ${GO_TAGS:+-tags "$GO_TAGS"} -o "$out" .
done
ls -l build/cross
