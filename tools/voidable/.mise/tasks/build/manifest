#!/usr/bin/env bash
#MISE description="Build @voidable/ui and copy its manifest into the Go embed directory"
set -euo pipefail

here="$(cd "$(dirname "$0")/../../.." && pwd)"
root="$(cd "$here/../.." && pwd)"
dist="$root/packages/ui/dist"

if [[ "${VOIDABLE_SKIP_UI_BUILD:-}" != "1" ]]; then
  (cd "$root" && pnpm --filter @voidable/ui build)
fi

out="$here/internal/infra/embedded/data/manifest"
mkdir -p "$out"
cp "$dist/custom-elements.json" "$dist/components.json" "$out/"
echo "manifest copied to $out"
