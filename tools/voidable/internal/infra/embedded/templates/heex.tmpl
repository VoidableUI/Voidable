{{- /* voidable gen heex: Phoenix function components, one per element. */ -}}
defmodule VoidableUI.Components do
  @moduledoc """
  HEEx function components for all Voidable web components.

  Generated by `voidable gen heex` from @voidable/ui {{.Version}}. Do not edit.

  Each function component renders the corresponding `<void-*>` custom element tag.
  Use LiveView's own bindings (`phx-click`, `phx-change`, `phx-submit`) first.
  Components that fire events take `events` to bridge them to LiveView's
  `pushEvent` through the `VoidEvent` hook: `events` (all of the component's
  events), `events={["void-close"]}` (those) or nothing (no hook, the default).
  """

  use Phoenix.Component

  defp unique_id, do: System.unique_integer([:positive]) |> Integer.to_string()

  defp void_events(nil, _all), do: nil
  defp void_events(false, _all), do: nil
  defp void_events(true, all), do: all
  defp void_events([], _all), do: nil
  defp void_events(names, _all) when is_list(names), do: Enum.join(names, ",")
  defp void_events("", _all), do: nil
  defp void_events(names, _all) when is_binary(names), do: names

  defp void_hook(events), do: if(void_events(events, ""), do: "VoidEvent")
{{- range .Elements}}
{{- $el := .}}

  @doc "{{elixirDoc .Description}}"
{{- if .Events}}
  attr :id, :string, default: nil
  attr :events, :any, default: nil, doc: "Bridge these events to pushEvent: true for all ({{events $el}}), or a list of names."
{{- end}}
{{- range .Attributes}}
{{- if ne .Name "id"}}
  attr :{{assign .}}, {{heexType .}}, default: {{heexDefault .}}{{if heexValues .}}, values: [{{quoteList .Values}}]{{end}}
{{- end}}
{{- end}}
  attr :rest, :global
  slot :inner_block

  def {{fn .Tag}}(assigns) do
    ~H"""
    <{{.Tag}}
{{- if .Events}}
      id={@id || "{{.Tag}}-#{unique_id()}"}
{{- end}}
{{- range .Attributes}}
{{- if ne .Name "id"}}
      {{.Name}}={@{{assign .}}}
{{- end}}
{{- end}}
{{- if .Events}}
      phx-hook={void_hook(@events)}
      data-void-events={void_events(@events, "{{events $el}}")}
{{- end}}
      {@rest}
    >
      {render_slot(@inner_block)}
    </{{.Tag}}>
    """
  end
{{- end}}
end
