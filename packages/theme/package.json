{
  "name": "@voidable/theme",
  "version": "0.0.0",
  "description": "CSS custom properties, design tokens, reset and component styles for Voidable UI",
  "keywords": ["css", "design-tokens", "theme", "custom-properties", "dark-mode", "design-system", "void-ui"],
  "homepage": "https://voidable.dev",
  "bugs": {
    "url": "https://github.com/VoidableUI/Voidable/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "license": "MIT",
  "style": "./dist/void.css",
  "exports": {
    ".": { "style": "./dist/void.css", "default": "./dist/void.css" },
    "./core": "./dist/core.css",
    "./tokens": "./dist/tokens.css",
    "./base": "./dist/base.css",
    "./layers": "./dist/layers.css",
    "./primitives": "./dist/primitives.css",
    "./knobs": "./dist/knobs.css",
    "./reset": "./dist/reset.css",
    "./type": "./dist/type.css",
    "./components/*": "./dist/components/*",
    "./patterns/*": "./dist/patterns/*",
    "./themes/*": "./dist/themes/*",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*",
    "./skins/*": "./dist/skins/*",
    "./dtcg/*": "./dist/dtcg/*",
    "./json/*": "./dist/json/*",
    "./knobs.json": "./dist/knobs.json",
    "./component-tokens.json": "./dist/component-tokens.json",
    "./skin": {
      "types": "./dist/skin.d.ts",
      "default": "./dist/skin.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "default": "./dist/names.js"
    }
  },
  "files": ["src", "dist"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoidableUI/Voidable.git",
    "directory": "packages/theme"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/export-tokens.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "generate": "node scripts/build.mjs --generated-only"
  },
  "devDependencies": {
    "lightningcss": "^1.32.0",
    "postcss": "^8.5.12",
    "postcss-selector-parser": "^6.1.2"
  }
}
