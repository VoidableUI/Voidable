{
  "name": "@voidable/ui-alpine",
  "version": "0.0.0",
  "description": "Alpine.js plugin for Voidable UI web components",
  "keywords": ["alpine", "alpinejs", "livewire", "web-components", "custom-elements", "void-ui"],
  "homepage": "https://voidable.dev",
  "bugs": {
    "url": "https://github.com/VoidableUI/Voidable/issues"
  },
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/alpine.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "alpinejs": ">=3.0.0"
  },
  "devDependencies": {
    "alpinejs": "^3.14.0",
    "@types/alpinejs": "^3.13.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.1.0",
    "@vitest/coverage-v8": "3.2.4",
    "happy-dom": "^17.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoidableUI/Voidable.git",
    "directory": "packages/alpine"
  },
  "publishConfig": {
    "access": "public"
  }
}
