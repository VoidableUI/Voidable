{
  "name": "@voidable/ui",
  "version": "0.0.0",
  "description": "Lit 3 web components for Voidable UI: light DOM, no visual CSS until a theme is loaded",
  "keywords": ["web-components", "lit", "custom-elements", "ui", "component-library", "design-system", "light-dom", "void-ui"],
  "homepage": "https://voidable.dev",
  "bugs": {
    "url": "https://github.com/VoidableUI/Voidable/issues"
  },
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*.js"
  ],
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./base": {
      "types": "./dist/base.d.ts",
      "default": "./dist/base.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./components/charts/*": null,
    "./types/elements": {
      "types": "./dist/types/elements.d.ts"
    },
    "./types/react": {
      "types": "./dist/types/react.d.ts"
    },
    "./types/solid": {
      "types": "./dist/types/solid.d.ts"
    },
    "./types/solid2": {
      "types": "./dist/types/solid2.d.ts"
    },
    "./types/svelte": {
      "types": "./dist/types/svelte.d.ts"
    },
    "./types/vue": {
      "types": "./dist/types/vue.d.ts"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "default": "./dist/angular/index.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./components.json": "./dist/components.json",
    "./vscode.html-custom-data.json": "./dist/vscode.html-custom-data.json",
    "./web-types.json": "./dist/web-types.json"
  },
  "files": ["dist"],
  "customElements": "dist/custom-elements.json",
  "web-types": "./dist/web-types.json",
  "scripts": {
    "build": "vite build && cem analyze && node cem/generate.js && node cem/check-types.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p type-tests/react && tsc -p type-tests/solid && tsc -p type-tests/solid2 && tsc -p type-tests/svelte && tsc -p type-tests/vue"
  },
  "peerDependencies": {
    "lit": "^3.3.0",
    "@angular/core": ">=19",
    "@angular/forms": ">=19",
    "@types/react": ">=19",
    "solid-js": ">=1.8.0",
    "svelte": ">=5",
    "vue": ">=3.5"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@angular/forms": {
      "optional": true
    },
    "@types/react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "lit": "^3.3.0",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "rxjs": "^7.8.0",
    "@types/react": "^19.0.0",
    "solid-js": "^1.8.0",
    "svelte": "^5.0.0",
    "vue": "^3.5.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^4.1.0",
    "happy-dom": "^20.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoidableUI/Voidable.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public"
  }
}
