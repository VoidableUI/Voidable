<div id="lab-panel">
  <void-card id="lab-card">
    <void-card-header>
      <void-card-title>Panel <%= lab["version"] %></void-card-title>
    </void-card-header>
    <void-card-body>
      <void-field label="Pick">
        <void-select id="lab-select" value="<%= lab["select"] %>">
          <select name="pick">
            <% lab["options"].each do |o| %><option value="<%= o %>">Option <%= o %> v<%= lab["version"] %></option><% end %>
          </select>
        </void-select>
      </void-field>
      <void-checkbox-group id="lab-group" label="Toppings" name="toppings">
        <void-checkbox id="lab-olives" value="olives">Olives</void-checkbox>
        <void-checkbox id="lab-basil" value="basil" checked>Basil</void-checkbox>
      </void-checkbox-group>
      <void-tabs id="lab-tabs">
        <void-tabs-list>
          <void-tabs-trigger value="one">One</void-tabs-trigger>
          <void-tabs-trigger value="two">Two</void-tabs-trigger>
        </void-tabs-list>
        <void-tabs-content value="one">Panel one v<%= lab["version"] %></void-tabs-content>
        <void-tabs-content value="two">Panel two v<%= lab["version"] %></void-tabs-content>
      </void-tabs>
      <void-dropdown-menu id="lab-menu">
        <void-dropdown-menu-trigger><button id="lab-menu-trigger" type="button">Actions v<%= lab["version"] %></button></void-dropdown-menu-trigger>
        <void-dropdown-menu-content>
          <void-dropdown-menu-item>Rename</void-dropdown-menu-item>
          <void-dropdown-menu-item>Archive</void-dropdown-menu-item>
        </void-dropdown-menu-content>
      </void-dropdown-menu>
      <void-button id="lab-open-dialog" onclick="document.getElementById('lab-dialog').open = true">Open dialog</void-button>
    </void-card-body>
  </void-card>
  <void-dialog id="lab-dialog"<%= " open" if lab["dialog"] %>>
    <void-dialog-title>Dialog v<%= lab["version"] %></void-dialog-title>
    <void-dialog-body>
      <p class="lab-dialog-body">Dialog body v<%= lab["version"] %></p>
    </void-dialog-body>
  </void-dialog>
</div>
