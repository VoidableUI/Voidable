{
  "name": "@voidable/ui-react",
  "version": "0.0.0",
  "description": "React wrappers and hooks for Voidable UI web components",
  "keywords": ["react", "web-components", "custom-elements", "wrapper", "void-ui"],
  "homepage": "https://voidable.dev",
  "bugs": {
    "url": "https://github.com/VoidableUI/Voidable/issues"
  },
  "type": "module",
  "sideEffects": true,
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@voidable/ui": "workspace:*",
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@voidable/ui": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "happy-dom": "^20.9.0",
    "vitest": "^4.1.0",
    "@vitest/coverage-v8": "4.1.5",
    "@types/react": "^19.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VoidableUI/Voidable.git",
    "directory": "packages/react"
  },
  "publishConfig": {
    "access": "public"
  }
}
